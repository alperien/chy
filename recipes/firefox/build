#!/bin/sh -e
# Mozilla ships a relocatable build; unpack it and it runs. No reason to
# spend hours compiling our own worse copy.

dest="$1$CHY_ROOT/usr/lib/firefox"
mkdir -p "$dest" "$1$CHY_ROOT/usr/bin"
cp -a . "$dest"

# The tarball has no rpath into our lib dir, so point LD_LIBRARY_PATH at
# it. This is the launcher convention chy expects for binary packages.
cat > "$1$CHY_ROOT/usr/bin/firefox" <<LAUNCHER
#!/bin/sh
LD_LIBRARY_PATH="$CHY_PREFIX/lib\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH
exec "$CHY_PREFIX/lib/firefox/firefox" "\$@"
LAUNCHER
chmod 755 "$1$CHY_ROOT/usr/bin/firefox"
