#!/usr/bin/env python3
"""Turn Void Linux package data into chy recipes.

    chytrans snapshot --out DIR NAME...             (network)
    chytrans translate --snapshot DIR --out DIR NAME...   (offline)
    chytrans overlay-check --snapshot DIR --overlay DIR   (offline)

The moving parts: the snapshot, the emitted outputs, shlibs.map,
provided.suggested, refusals and exit status, soak deferrals, the
kill-switch pin, overlay staleness.
Python 3.9+, stdlib only.
"""

import argparse
import os
import shutil
import subprocess
import sys
import tempfile

_SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, _SCRIPT_DIR)

import repodata
import snapshot

TRANSLATOR_VERSION = "1"

# the oldest chy that reads every contract this translator emits
# (patchlevel arrived with 0.5.0). Bumps only in contract-widening
# changes; chy refuses repos newer than itself.
MIN_CHY = "0.5.0"


class _SliceMiss(Exception):
    """A flatten or closure lookup missed the snapshot slice;
    that's a per-package refusal naming the dependency."""

    def __init__(self, name):
        super().__init__(name)
        self.name = name


def _is_handwritten(outroot, name):
    """True when recipes/<name>/meta under the output root carries the
    exact line 'origin: handwritten' (trailing whitespace tolerated).
    One grammar, shared verbatim with ci/repo-sync.sh's seed grep and
    emit.write's guard: a looser parser here once meant the three
    could disagree and a handwritten recipe could be seeded by one
    layer and overwritten by another.  Handwritten recipes are never
    attempted and never overwritten."""
    meta = os.path.join(outroot, "recipes", name, "meta")
    if not os.path.isfile(meta):
        return False
    with open(meta, "r", encoding="utf-8", errors="replace") as f:
        return any(line.rstrip() == "origin: handwritten" for line in f)


def _normalize_dump(dump_root, name):
    """evaluate.sh is handed an out-dir; the fixed dump layout is
    <out>/<name>/{vars,options,functions/}.  If a flat layout arrives
    instead (older dumps were laid out flat), restructure it so emit
    sees the fixed shape."""
    if os.path.isfile(os.path.join(dump_root, name, "vars")):
        return
    if not os.path.isfile(os.path.join(dump_root, "vars")):
        return
    pkgdir = os.path.join(dump_root, name)
    os.mkdir(pkgdir)
    for entry in os.listdir(dump_root):
        if entry != name:
            os.rename(os.path.join(dump_root, entry),
                      os.path.join(pkgdir, entry))


def _package_references(name, snap, dump_root, result, pmap):
    """Every binary package name this recipe referenced: its repodata
    run_depends, its evaluated hostmakedepends+makedepends, and the
    injected tools (parsed; libc dropped, virtual names resolved to
    their providers when the slice settles them).  Raw material for
    the provided.suggested hints."""
    refs = set()
    for token in snap.slice[name].get("run_depends", []):
        dep, kind = repodata.parse_dep(token)
        if dep in repodata.LIBC:
            continue
        if repodata.canonical(dep) not in snap.slice:
            resolved = repodata.resolve_virtual(dep, snap.slice, pmap)
            if resolved is not None:
                dep = resolved
            elif kind == "virtual":
                continue
        refs.add(dep)
    refs |= snapshot.dump_dep_names(dump_root, name)
    # plus emit's injections, exactly as emitted: injected tools are
    # the makedepends entries not derivable from the dump or run_depends
    # (integration fix, meeting #3: the snapshot-side injection table is
    # a fetch-coverage superset and can't leak into provided.suggested)
    derivable = set()
    for b in refs:
        src = repodata.flatten(b, snap.slice)
        if src is not None:
            derivable.add(src)
    refs |= {m for m in (set(result.makedepends) | set(result.depends))
             if m not in derivable}
    return refs


def _provided_contrib(name, result, snap, dump_root):
    """One emitted recipe's contribution to provided.suggested:
    {source package: set of binary names referenced}.  The source set
    is exactly result.depends + result.makedepends (emit's word) plus the
    transitive run_depends closures of what was referenced; the binary
    names ride along as the install-hint column.  Any lookup that
    misses the slice raises _SliceMiss -> per-package refusal."""
    direct = set(result.depends) | set(result.makedepends)
    pmap = repodata.providers_map(snap.slice)
    hints = {}
    walk = []
    for binary in sorted(_package_references(name, snap, dump_root, result,
                                             pmap)):
        src = repodata.flatten(binary, snap.slice)
        if src is None:
            raise _SliceMiss(binary)
        if src in direct:
            hints.setdefault(src, set()).add(binary)
            walk.append(binary)
    # Anything emit derived that our reference mirror didn't see gets
    # its own name as the hint, and is closure-walked when the slice
    # also knows it as a binary name (it normally does).
    for src in sorted(direct - set(hints)):
        hints.setdefault(src, set()).add(src)
        if src in snap.slice:
            walk.append(src)
    seen = set(walk)
    while walk:
        binary = walk.pop()
        entry = snap.slice.get(binary)
        if entry is None:
            raise _SliceMiss(binary)
        for token in entry.get("run_depends", []):
            dep, kind = repodata.parse_dep(token)
            if dep in repodata.LIBC:
                continue
            if repodata.canonical(dep) not in snap.slice:
                resolved = repodata.resolve_virtual(dep, snap.slice, pmap)
                if resolved is not None:
                    dep = resolved
                elif kind == "virtual":
                    # No provider the slice settles; hint material
                    # only, so warn and keep going.
                    sys.stderr.write("chytrans: warning: %s: skipping"
                                     " virtual dependency %s in provided"
                                     " closure\n" % (name, token))
                    continue
            if dep in seen:
                continue
            seen.add(dep)
            src = repodata.flatten(dep, snap.slice)
            if src is None:
                raise _SliceMiss(dep)
            hints.setdefault(src, set()).add(dep)
            walk.append(dep)
    return hints


def _write_lines(path, lines):
    with open(path, "w", encoding="utf-8") as f:
        for line in lines:
            f.write(line + "\n")


def cmd_translate(args):
    names = sorted(set(args.names))
    outroot = os.path.abspath(args.out)
    os.makedirs(outroot, exist_ok=True)

    eval_sh = os.path.join(_SCRIPT_DIR, "evaluate.sh")
    if not os.path.isfile(eval_sh):
        sys.stderr.write("chytrans: translator/evaluate.sh is missing;"
                         " cannot translate\n")
        return 1
    try:
        import emit
    except ImportError:
        sys.stderr.write("chytrans: translator/emit.py is missing;"
                         " cannot translate\n")
        return 1
    try:
        snap = snapshot.load(args.snapshot)
    except snapshot.SnapshotError as err:
        sys.stderr.write("chytrans: %s\n" % err)
        return 1

    report = []
    if snap.pin:
        # a fetched snapshot says so in the run ledger.
        report.append("pin: %s" % snap.pin)
    translated = []
    exceptions = []
    deferred = []
    held = []
    hints = {}

    # soak entries age offline: the snapshot records only server-supplied
    # epochs, so the reference instant is the newest epoch anywhere in
    # snapshot/soak (a local clock would break byte-identical
    # reruns).  Ages are floor-day lower bounds; the recorded verdict,
    # not the age, is what defers.
    soak_ref = max((e for row in snap.soak.values()
                    for e in (row[1], row[2]) if e > 0), default=0)

    def refuse(name, reason):
        report.append("refused: %s: %s" % (name, reason))
        sys.stderr.write("chytrans: %s: refused: %s\n" % (name, reason))
        # a refused name with a recipe already in the out-root (its
        # seeded last translation) is held, not gone: it stays a repo
        # member, exactly like a deferred one
        if os.path.isdir(os.path.join(outroot, "recipes", name)):
            held.append(name)

    for name in names:
        if _is_handwritten(outroot, name):
            exceptions.append(name)
            report.append("exception: %s" % name)
            continue
        if name not in snap.slice:
            # a package gone from repodata hits this refusal before
            # soak is consulted.
            refuse(name, "not in snapshot slice")
            continue
        soak = snap.soak.get(name)
        if soak is not None and soak[3] == "deferred":
            # deferred, not refused.  Kept, never regenerated: a
            # recipe already in the out-root survives untouched (like a
            # handwritten exception), absence emits nothing, and exit
            # status is unaffected either way.
            pkgver, lastmod, committer = soak[0], soak[1], soak[2]
            clocks = [e for e in (lastmod, committer) if e > 0]
            age = (soak_ref - max(clocks)) // 86400 if clocks else 0
            deferred.append(name)
            report.append("deferred: %s %s age=%d" % (name, pkgver, age))
            continue
        srcdir = snap.srcpkg_dir(name)
        if srcdir is None:
            refuse(name, "srcpkg tree missing from snapshot")
            continue
        dump_root = tempfile.mkdtemp(prefix="chytrans-dump.")
        try:
            try:
                proc = subprocess.run(["bash", eval_sh, srcdir, dump_root],
                                      stdout=subprocess.PIPE,
                                      stderr=subprocess.PIPE, timeout=300)
            except subprocess.TimeoutExpired:
                refuse(name, "evaluation timed out")
                continue
            if proc.returncode != 0:
                lines = proc.stderr.decode(errors="replace").strip()
                detail = lines.splitlines()[-1] if lines else ""
                refuse(name, "evaluation failed"
                       + (": %s" % detail if detail else ""))
                continue
            _normalize_dump(dump_root, name)
            result = emit.translate(name, snap, dump_root)
            if not result.ok:
                refuse(name, result.reason)
                continue
            try:
                contrib = _provided_contrib(name, result, snap, dump_root)
            except _SliceMiss as miss:
                refuse(name, "dependency not in snapshot slice: %s"
                       % miss.name)
                continue
            emit.write(result, outroot)
            translated.append(name)
            report.append("translated: %s" % name)
            for src, binaries in contrib.items():
                hints.setdefault(src, set()).update(binaries)
        finally:
            shutil.rmtree(dump_root, ignore_errors=True)

    # Repo-level outputs: shlibs.map, provided.suggested, report,
    # TRANSLATOR_VERSION.  Deterministic, everything sorted.
    map_lines, ambiguous = repodata.shlibs_map_with_ambiguities(
        snap.slice, snap.shlibs)
    _write_lines(os.path.join(outroot, "shlibs.map"), map_lines)

    # Deferred and held names drop out like exceptions: a kept recipe
    # is a repo member, not something the host must provide ("like a
    # handwritten exception").
    drop = set(translated) | set(exceptions) | set(deferred) | set(held)
    provided = ["%s %s" % (src, ",".join(sorted(hints[src])))
                for src in sorted(hints) if src not in drop]
    _write_lines(os.path.join(outroot, "provided.suggested"), provided)

    report.extend("ambiguous-soname: %s" % soname for soname in ambiguous)
    _write_lines(os.path.join(outroot, "report"), report)
    _write_lines(os.path.join(outroot, "TRANSLATOR_VERSION"),
                 [TRANSLATOR_VERSION])
    _write_lines(os.path.join(outroot, "min-chy"), [MIN_CHY])

    # exit 0 iff every requested package was translated, is a kept
    # handwritten exception, or was deferred by the soak gate.
    return 0 if set(names) == set(translated) | set(exceptions) \
        | set(deferred) else 1


def cmd_snapshot(args):
    try:
        snapshot.create(args.names, args.out)
    except snapshot.SnapshotError as err:
        sys.stderr.write("chytrans: %s\n" % err)
        return 1
    return 0


def _overlay_base(odir):
    """The overlay's recorded provenance: the first
    `overlay-base:` value in overlay/<name>/meta, or None when the meta
    or the line (or its value) is absent."""
    meta = os.path.join(odir, "meta")
    if not os.path.isfile(meta):
        return None
    with open(meta, "r", encoding="utf-8", errors="replace") as f:
        for line in f:
            key, sep, value = line.partition(":")
            if sep and key.strip() == "overlay-base":
                return value.strip() or None
    return None


def _commits_match(a, b):
    """Prefix-tolerant commit compare, lowercase hex: either one a
    prefix of the other (live source-revisions are abbreviated; pins and
    fixtures may be 40-hex)."""
    a, b = a.strip().lower(), b.strip().lower()
    return bool(a) and bool(b) and (a.startswith(b) or b.startswith(a))


def cmd_overlay_check(args):
    """One line per overlay/<name>/ (byte-sorted), exit 0 iff no
    alarm.  Separate from translate; translate's exit behavior is
    untouched by overlay state."""
    try:
        snap = snapshot.load(args.snapshot)
    except snapshot.SnapshotError as err:
        sys.stderr.write("chytrans: %s\n" % err)
        return 1
    overlay_root = os.path.abspath(args.overlay)
    if not os.path.isdir(overlay_root):
        sys.stderr.write("chytrans: %s: not an overlay directory\n"
                         % overlay_root)
        return 1
    alarms = 0

    def alarm(name, detail):
        sys.stderr.write("chytrans: %s: stale-overlay: %s\n" % (name, detail))

    for name in sorted(os.listdir(overlay_root)):
        if not os.path.isdir(os.path.join(overlay_root, name)):
            continue
        # Upstream is where the default repo would fetch this package today:
        # under a pin the pin itself, else its current
        # source-revisions commit; a name the snapshot doesn't know has
        # no upstream and never alarms.
        src = repodata.source_commit(name, snap.slice)
        if src is None:
            print("overlay: %s: local (no upstream in snapshot)" % name)
            continue
        upstream = snap.pin if snap.pin else src
        base = _overlay_base(os.path.join(overlay_root, name))
        if base is None:
            # Provenance is mandatory for a shadowing overlay.
            print("overlay: %s: unprovenanced (upstream at %s)"
                  % (name, upstream))
            alarm(name, "unprovenanced (upstream at %s)" % upstream)
            alarms += 1
        elif _commits_match(base, upstream):
            print("overlay: %s: current (base %s)" % (name, base))
        else:
            print("overlay: %s: STALE: base %s, upstream now %s"
                  % (name, base, upstream))
            alarm(name, "base %s, upstream now %s" % (base, upstream))
            alarms += 1
    return 1 if alarms else 0


def main(argv):
    parser = argparse.ArgumentParser(
        prog="chytrans",
        description="translate Void Linux packages into chy recipes")
    sub = parser.add_subparsers(dest="command", required=True)

    p_snap = sub.add_parser("snapshot",
                            help="fetch inputs and build a snapshot")
    p_snap.add_argument("--out", required=True, metavar="DIR")
    p_snap.add_argument("names", nargs="+", metavar="NAME")
    p_snap.set_defaults(func=cmd_snapshot)

    p_tr = sub.add_parser("translate",
                          help="translate offline from a snapshot")
    p_tr.add_argument("--snapshot", "--from-snapshot", dest="snapshot",
                      required=True, metavar="DIR")
    p_tr.add_argument("--out", required=True, metavar="DIR")
    p_tr.add_argument("names", nargs="+", metavar="NAME")
    p_tr.set_defaults(func=cmd_translate)

    p_oc = sub.add_parser("overlay-check",
                          help="alarm on overlay recipes whose upstream"
                               " moved")
    p_oc.add_argument("--snapshot", required=True, metavar="DIR")
    p_oc.add_argument("--overlay", required=True, metavar="DIR")
    p_oc.set_defaults(func=cmd_overlay_check)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
