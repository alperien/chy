#!/bin/sh
# chy. A tiny package manager for hand-built Linux systems.
#
# One file. POSIX sh. Readable in one sitting. The state is the filesystem.
# $CHY_ROOT defines the world; nothing else knows where things live.
#
# the truth after install. install walks depends+makedepends,
# checks conflicts, and builds in the unique smallest valid order; after
# linking, runtime verification runs ldd over the new ELFs and warns
# about unresolved libraries; doctor re-runs that scan over every
# installed package and audits manifests for broken, missing, or foreign
# farm links. Sources are fetched and verified, built into
# store/<name>-<version>/, linked into the usr/ symlink farm, and
# recorded under db/installed/.

CHY_VERSION=0.3.0
set -u

# --------------------------------------------------------------- output --
# Every line chy itself prints follows one grammar: progress and
# completion on stdout, warnings and errors on stderr, all "chy: <name>:".

say() { printf 'chy: %s: %s\n' "$1" "$2"; }
warn() { printf 'chy: %s: warning: %s\n' "$1" "$2" >&2; }
err() { printf 'chy: %s: error: %s\n' "$1" "$2" >&2; }
fail() { err "$1" "$2"; exit 1; }

usage() {
    cat <<EOF
chy $CHY_VERSION - a tiny package manager for hand-built Linux systems

usage:
  chy install [--no-deps] name...
                        resolve, fetch, verify, build, and link packages
  chy remove [-r] name...
                        unlink and delete packages; -r cascades orphans
  chy list [name...]    list installed packages
  chy provided          list host-provided package names
  chy doctor            report unresolved libraries and manifest drift
  chy version           print chy's version

\$CHY_ROOT selects the root (default: \$HOME/.chy).
EOF
}

# ----------------------------------------------------------- validation --
# Package names match [a-z0-9][a-z0-9+._-]*; versions and revisions match
# [A-Za-z0-9._+]+ (no hyphen, so store/<name>-<version> parses cleanly).
# "install" and "order" are reserved: reserved output scopes.

valid_name() {
    case $1 in ''|[!a-z0-9]*|install|order) return 1 ;; esac
    case ${1#?} in *[!a-z0-9+._-]*) return 1 ;; *) return 0 ;; esac
}

valid_version() {
    case $1 in ''|*[!A-Za-z0-9._+]*) return 1 ;; *) return 0 ;; esac
}

valid_sha256() {
    [ "${#1}" -eq 64 ] || return 1
    case $1 in *[!0-9a-f]*) return 1 ;; *) return 0 ;; esac
}

# The root must be absolute, with no whitespace and no . or .. components;
# trailing slashes are stripped. Anything else is refused at startup.
bad_root() {
    printf 'chy: invalid CHY_ROOT %s: %s\n' "${CHY_ROOT:-(empty)}" "$1" >&2
    exit 2
}

check_root() {
    [ -n "${CHY_ROOT:-}" ] || CHY_ROOT=${HOME:-}/.chy
    while [ "${CHY_ROOT%/}" != "$CHY_ROOT" ]; do CHY_ROOT=${CHY_ROOT%/}; done
    case $CHY_ROOT in /*) ;; *) bad_root 'not an absolute path' ;; esac
    case $CHY_ROOT in *[[:space:]]*) bad_root 'contains whitespace' ;; esac
    case $CHY_ROOT/ in */./*|*/../*) bad_root 'has . or .. components' ;; esac
}

# A tool is checked at the moment it is needed.
require() { # require <name> <tool>
    command -v "$2" >/dev/null 2>&1 || fail "$1" "missing tool: $2"
}

# The significant lines of a list-valued recipe file: blank lines and
# lines starting with '#' are ignored.
sig_lines() {
    while IFS= read -r sl_line || [ -n "$sl_line" ]; do
        case $sl_line in ''|'#'*) continue ;; esac
        case $sl_line in *[![:space:]]*) printf '%s\n' "$sl_line" ;; esac
    done <"$1"
}

first_field() { # print the first whitespace-separated field of $1
    ff_first=
    read -r ff_first _ <<EOF || :
$1
EOF
    printf '%s\n' "$ff_first"
}

sha_of() { # print the sha256 digest of a file
    sha_out=$(sha256sum "$1") || return 1
    printf '%s\n' "${sha_out%%[[:space:]]*}"
}

# Name sets are strings like " a b c ". Names never contain whitespace,
# so membership is a case match and the resolver needs no arrays.
in_set() { # in_set <name> <set>
    case $2 in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

# Walking a set: `REST=$set; while pop; do ... $POP ... done`. pop consumes
# the first name of $REST into $POP; false when done. Never nest walks.
pop() {
    REST=${REST# }
    [ -n "$REST" ] || return 1
    case $REST in
        *' '*) POP=${REST%% *} REST=${REST#* } ;;
        *)     POP=$REST REST= ;;
    esac
}

# The names in a list-valued file: the first field of every significant
# line. A missing file is an empty list.
list_names() { # list_names <file>
    [ -f "$1" ] || return 0
    sig_lines "$1" | while IFS= read -r ln_l; do first_field "$ln_l"; done
}

provided_names() { # db/provided names: sorted, de-duplicated
    list_names "$CHY_ROOT/db/provided" | LC_ALL=C sort -u
}

# -------------------------------------------------------------- recipes --
# Validate recipes/<name>/ completely and set R_DIR, R_VER, R_REV. Any
# invalidity fails the install before any fetching begins.
recipe_check() { # recipe_check <name>
    R_DIR=$CHY_ROOT/recipes/$1
    [ -d "$R_DIR" ] || fail "$1" "unknown package: no recipe at recipes/$1"
    for rc_f in version sources checksums build; do
        [ -f "$R_DIR/$rc_f" ] || fail "$1" "recipe missing required file: $rc_f"
    done

    # kind: absent means source; binary is a provenance marker - the
    # pipeline is identical (the launcher convention binds the recipe,
    # not chy). Anything else is an error naming the kind.
    if [ -f "$R_DIR/kind" ]; then
        rc_kind=
        read -r rc_kind <"$R_DIR/kind" || :
        case $rc_kind in source|binary) ;;
            *) fail "$1" "unsupported kind: ${rc_kind:-(empty)}" ;;
        esac
    fi

    # version: one line, "<version>" or "<version> <revision>".
    R_VER='' R_REV=''
    read -r R_VER R_REV <"$R_DIR/version" || :
    [ -n "$R_REV" ] || R_REV=1
    valid_version "$R_VER" || fail "$1" "invalid version: '$R_VER'"
    valid_version "$R_REV" || fail "$1" "invalid revision: '$R_REV'"

    # sources and checksums pair line for line, by ordinal.
    rc_nsrc=$(( $(sig_lines "$R_DIR/sources" | wc -l) ))
    rc_nsum=$(( $(sig_lines "$R_DIR/checksums" | wc -l) ))
    [ "$rc_nsrc" -gt 0 ] || fail "$1" "sources lists no sources"
    [ "$rc_nsrc" -eq "$rc_nsum" ] ||
        fail "$1" "sources/checksums line counts differ ($rc_nsrc vs $rc_nsum)"

    sig_lines "$R_DIR/checksums" | while IFS= read -r rc_line; do
        valid_sha256 "$(first_field "$rc_line")" || exit 1
    done || fail "$1" "checksums must be lowercase sha256 hex digests"
    # FIXME: names the recipe but not which checksums line is bad

    # Every source line needs a filename; no two lines can share one.
    sig_lines "$R_DIR/sources" | while IFS= read -r rc_line; do
        rc_url=$(first_field "$rc_line")
        [ -n "${rc_url##*/}" ] || exit 1
    done || fail "$1" "a sources line has no usable filename"
    rc_dup=$(
        sig_lines "$R_DIR/sources" | while IFS= read -r rc_line; do
            rc_url=$(first_field "$rc_line")
            printf '%s\n' "${rc_url##*/}"
        done | LC_ALL=C sort | uniq -d
    )
    [ -z "$rc_dup" ] || fail "$1" "duplicate source filename: $rc_dup"
}

# ---------------------------------------------------------------- fetch --
fetch_url() { # fetch_url <name> <url> <outfile>
    if command -v curl >/dev/null 2>&1; then
        curl -fL -o "$3" -- "$2"
    elif command -v wget >/dev/null 2>&1; then
        wget -O "$3" -- "$2"
    else
        fail "$1" 'missing tool: curl or wget'
    fi
}

# One source line: a verified cache hit is used as-is; otherwise the
# line's URLs are walked in order - download, verify, on mismatch delete
# and advance - so a corrupt primary degrades to the mirror.
fetch_source() { # fetch_source <name> <sha256> <source line>
    fs_file=$(first_field "$3")
    fs_file=${fs_file##*/}
    fs_cache=$CHY_ROOT/cache/$fs_file
    say "$1" "fetch $fs_file"
    require "$1" sha256sum
    if [ -f "$fs_cache" ] && [ "$(sha_of "$fs_cache")" = "$2" ]; then
        return 0
    fi
    rm -f "$fs_cache"
    mkdir -p "$CHY_ROOT/cache"
    fs_rest=$3 fs_got='(nothing downloaded)'
    while [ -n "$fs_rest" ]; do
        fs_url=${fs_rest%%[[:space:]]*}
        if [ "$fs_url" = "$fs_rest" ]; then
            fs_rest=
        else
            fs_rest=${fs_rest#*[[:space:]]}
        fi
        [ -n "$fs_url" ] || continue
        if fetch_url "$1" "$fs_url" "$fs_cache"; then
            fs_got=$(sha_of "$fs_cache")
            [ "$fs_got" = "$2" ] && return 0
        else
            fs_got='(download failed)'
        fi
        rm -f "$fs_cache"
    done
    fail "$1" "checksum mismatch for $fs_file: expected $2, got $fs_got"
}

# Every source is fetched and verified before the build dir is prepared.
fetch_all() { # fetch_all <name>
    mkdir -p "$CHY_ROOT/build"
    sig_lines "$R_DIR/sources"   >"$CHY_ROOT/build/srcs"
    sig_lines "$R_DIR/checksums" >"$CHY_ROOT/build/sums"
    while IFS= read -r fa_line <&3 && IFS= read -r fa_sum <&4; do
        fetch_source "$1" "$(first_field "$fa_sum")" "$fa_line"
    done 3<"$CHY_ROOT/build/srcs" 4<"$CHY_ROOT/build/sums"
}

# ------------------------------------------------------------ build dir --
is_archive() {
    case $1 in *.tar.gz|*.tgz|*.tar.xz|*.tar.bz2) return 0 ;; *) return 1 ;; esac
}

# extract (known archives) or copy (anything else) one fetched source
# into the build dir.
stage_source() { # stage_source <name> <filename> <dir>
    ss_cache=$CHY_ROOT/cache/$2
    if is_archive "$2"; then
        require "$1" tar
        tar -xf "$ss_cache" -C "$3" || fail "$1" "cannot extract $2"
    else
        cp "$ss_cache" "$3/" || fail "$1" "cannot copy $2 into the build dir"
    fi
}

# If extracting the first source yielded exactly one top-level entry -
# dotfiles included - and it is a directory, hoist its contents up one
# level so ./configure works from the top.
hoist() { # hoist <dir>
    h_count=0 h_only=
    for h_e in "$1"/* "$1"/.[!.]* "$1"/..?*; do
        { [ -e "$h_e" ] || [ -L "$h_e" ]; } || continue
        h_count=$((h_count + 1)) h_only=$h_e
    done
    if [ "$h_count" -ne 1 ] || [ ! -d "$h_only" ] || [ -L "$h_only" ]; then
        return 0
    fi
    mv "$h_only" "$1/.chy-hoist" || return 1
    for h_e in "$1/.chy-hoist"/* "$1/.chy-hoist"/.[!.]* "$1/.chy-hoist"/..?*; do
        { [ -e "$h_e" ] || [ -L "$h_e" ]; } || continue
        mv "$h_e" "$1/" || return 1
    done
    rmdir "$1/.chy-hoist"
}

# wipe scratch, stage every source (only the first gets hoisted), then
# apply patches/*.patch and *.diff as one list, byte order.
prepare_build() { # prepare_build <name>
    WORK=$CHY_ROOT/build/work
    DEST=$CHY_ROOT/build/dest
    rm -rf "$CHY_ROOT/build"
    mkdir -p "$WORK" "$DEST"

    sig_lines "$R_DIR/sources" >"$CHY_ROOT/build/srcs"
    pb_first=1
    while IFS= read -r pb_line; do
        pb_file=$(first_field "$pb_line")
        pb_file=${pb_file##*/}
        stage_source "$1" "$pb_file" "$WORK"
        if [ "$pb_first" -eq 1 ] && is_archive "$pb_file"; then
            hoist "$WORK" || fail "$1" "cannot hoist $pb_file"
        fi
        pb_first=0
    done <"$CHY_ROOT/build/srcs"

    for pb_p in "$R_DIR/patches/"*.patch "$R_DIR/patches/"*.diff; do
        [ -e "$pb_p" ] || continue
        printf '%s\n' "${pb_p##*/}"
    done | LC_ALL=C sort >"$CHY_ROOT/build/patchlist"
    while IFS= read -r pb_p; do
        require "$1" patch
        say "$1" "apply $pb_p"
        # TODO: -p1 is hardcoded; a few void patches want -p0 (libffi)
        (cd "$WORK" && patch -p1 <"$R_DIR/patches/$pb_p") ||
            fail "$1" "patch failed to apply: $pb_p"
    done <"$CHY_ROOT/build/patchlist"
}

# ---------------------------------------------------------------- build --
# sh recipes/<name>/build <destdir> <version>, cwd the prepared build
# dir, with the environment. A nonzero exit aborts the install.
run_build() { # run_build <name>
    say "$1" "build $1-$R_VER"
    (
        cd "$WORK" || exit 1
        CHY_PREFIX=$CHY_ROOT/usr
        PATH=$CHY_PREFIX/bin:$PATH
        CPPFLAGS="${CPPFLAGS:+$CPPFLAGS }-I$CHY_PREFIX/include"
        LDFLAGS="${LDFLAGS:+$LDFLAGS }-L$CHY_PREFIX/lib -Wl,-rpath,$CHY_PREFIX/lib"
        PKG_CONFIG_PATH="$CHY_PREFIX/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
        export CHY_ROOT CHY_PREFIX PATH CPPFLAGS LDFLAGS PKG_CONFIG_PATH
        exec sh "$CHY_ROOT/recipes/$1/build" "$DEST" "$R_VER"
    ) || fail "$1" "build failed"
}

# ------------------------------------------------------------ normalize --
# The build staged a DESTDIR image of the real prefix at $DEST$CHY_ROOT.
# Check it and normalize it, still in scratch, to a $CHY_ROOT-relative
# tree at $NORM. On failure the root is untouched.
normalize() { # normalize <name>
    NORM=$CHY_ROOT/build/pkg
    n_bad=$CHY_ROOT/build/norm-failed
    rm -f "$n_bad"
    require "$1" readlink

    find "$DEST" \( -type f -o -type l \) -print | while IFS= read -r n_p; do
        case $n_p in
            "$DEST$CHY_ROOT/"*) ;;
            *) err "$1" "staged outside the prefix: ${n_p#"$DEST"}"
                : >"$n_bad" ;;
        esac
    done
    [ ! -e "$n_bad" ] || fail "$1" "build staged files outside \$CHY_ROOT"

    if [ -z "$(find "$DEST$CHY_ROOT" \( -type f -o -type l \) -print 2>/dev/null)" ]; then
        fail "$1" "build installed nothing"
    fi

    find "$DEST" -type l -print | while IFS= read -r n_p; do
        n_t=$(readlink "$n_p")
        case $n_t in
            "$DEST"*)
                err "$1" "symlink baked with the staging path: ${n_p#"$DEST$CHY_ROOT/"} -> $n_t"
                : >"$n_bad" ;;
        esac
    done
    [ ! -e "$n_bad" ] || fail "$1" "symlink targets baked with \$1 (DESTDIR)"

    mv "$DEST$CHY_ROOT" "$NORM" || fail "$1" "cannot normalize the staged tree"
}

# -------------------------------------------------------------- linking --
# A farm symlink is owned by <name> iff the path component of its target
# right after store/ is exactly <name>.
owner_of() { # owner_of <link>: print the owning component, if any
    oo_t=$(readlink "$1") || return 0
    case $oo_t in
        store/*)   oo_t=${oo_t#store/} ;;
        */store/*) oo_t=${oo_t#*/store/} ;;
        *)         return 0 ;;
    esac
    printf '%s\n' "${oo_t%%/*}"
}

updots() { # print ../ once per directory level of a relative path
    ud_p=$1 ud_u=
    while [ "${ud_p#*/}" != "$ud_p" ]; do
        ud_p=${ud_p#*/}
        ud_u=../$ud_u
    done
    printf '%s\n' "$ud_u"
}

# Conflicts are found from the normalized tree before the store or farm
# is touched: the whole install links or none of it does. A needed file
# path may only be free or our own symlink; a needed directory path may
# only be free or a real directory.
conflict_scan() { # conflict_scan <name>
    LIST=$CHY_ROOT/build/files
    (cd "$NORM" && find . \( -type f -o -type l \) -print) |
        sed 's|^\./||' | LC_ALL=C sort >"$LIST"

    while IFS= read -r cs_p; do
        cs_d=$cs_p
        while [ "${cs_d%/*}" != "$cs_d" ]; do
            cs_d=${cs_d%/*}
            printf '%s\n' "$cs_d"
        done
    done <"$LIST" | LC_ALL=C sort -u >"$CHY_ROOT/build/dirs"

    cs_bad=0
    while IFS= read -r cs_d; do
        cs_f=$CHY_ROOT/$cs_d
        if [ -L "$cs_f" ]; then
            cs_own=$(owner_of "$cs_f")
            err "$1" "conflict: $cs_d is a symlink${cs_own:+ (owned by $cs_own)}, needed as a directory"
            cs_bad=1
        elif [ -e "$cs_f" ] && [ ! -d "$cs_f" ]; then
            err "$1" "conflict: $cs_d exists and is not a directory"
            cs_bad=1
        fi
    done <"$CHY_ROOT/build/dirs"

    while IFS= read -r cs_p; do
        cs_f=$CHY_ROOT/$cs_p
        if [ -L "$cs_f" ]; then
            cs_own=$(owner_of "$cs_f")
            if [ "$cs_own" != "$1" ]; then
                err "$1" "conflict: $cs_p${cs_own:+ (owned by $cs_own)}"
                cs_bad=1
            fi
        elif [ -e "$cs_f" ]; then
            err "$1" "conflict: $cs_p"
            cs_bad=1
        fi
    done <"$LIST"

    [ "$cs_bad" -eq 0 ] || fail "$1" "conflicts found; nothing was linked"
}

# store/<name>-<version> must be free or a replaceable real directory and
# store/<name> free or a symlink - anything else is a name/version
# collision, and chy fails rather than guessing.
shape_check() { # shape_check <name>
    sc_e=$CHY_ROOT/store/$1-$R_VER
    if [ -L "$sc_e" ] || { [ -e "$sc_e" ] && [ ! -d "$sc_e" ]; }; then
        fail "$1" "store/$1-$R_VER exists and is not a package directory"
    fi
    sc_a=$CHY_ROOT/store/$1
    if [ -e "$sc_a" ] && [ ! -L "$sc_a" ]; then
        fail "$1" "store/$1 exists and is not an alias symlink"
    fi
}

# Make the store entry visible: real directories, then one relative
# symlink per file, pointing through the store/<name> alias.
link_farm() { # link_farm <name>
    while IFS= read -r lf_p; do
        lf_d=${lf_p%/*}
        [ "$lf_d" = "$lf_p" ] || mkdir -p "$CHY_ROOT/$lf_d"
        rm -f "$CHY_ROOT/$lf_p"
        ln -s "$(updots "$lf_p")store/$1/$lf_p" "$CHY_ROOT/$lf_p" ||
            fail "$1" "cannot link $lf_p"
    done <"$LIST"
}

# The db entry is written last; its presence means "installed".
# depends/conflicts are verbatim recipe copies; the empty requested marker
# means "named on the command line" - dependency installs never carry it.
write_db() { # write_db <name> <requested: 1|0>
    wd_db=$CHY_ROOT/db/installed/$1
    rm -rf "$wd_db"
    mkdir -p "$wd_db"
    printf '%s %s\n' "$R_VER" "$R_REV" >"$wd_db/version"
    cp "$LIST" "$wd_db/manifest"
    [ ! -f "$R_DIR/depends" ] || cp "$R_DIR/depends" "$wd_db/depends"
    [ ! -f "$R_DIR/conflicts" ] || cp "$R_DIR/conflicts" "$wd_db/conflicts"
    [ "$2" -ne 1 ] || : >"$wd_db/requested"
}

# ------------------------------------------------- runtime verification --
# The pinned ELF scan: every
# lstat-regular file under $1 whose first four bytes are the ELF magic
# is fed to ldd once, with $CHY_ROOT/usr/lib prepended to
# LD_LIBRARY_PATH - verification sees exactly what a launched program
# will see. A missing library is a line whose fields 2-4 are literally
# "=> not found" (field 1 the soname); ldd's exit status and all other
# output are ignored. Output: the distinct missing sonames, one per
# line, byte-sorted, each with shlib_hint appended.

ELF_MAGIC=$(printf '\177ELF')

shlib_hint() { # " (package: <pkg>)" when shlibs.map knows the soname
    [ -f "$CHY_ROOT/shlibs.map" ] || return 0
    sh_pkg=$(sig_lines "$CHY_ROOT/shlibs.map" |
        LC_ALL=C awk -v s="$1" '$1 == s { print $2; exit }')
    [ -z "$sh_pkg" ] || printf ' (package: %s)\n' "$sh_pkg"
}

scan_needs() { # scan_needs <store entry dir>
    [ -d "$1" ] || return 0
    find "$1" -type f -print | while IFS= read -r sn_f; do
        sn_head=                        # the shell itself reads the magic:
        { IFS= read -r sn_head <"$sn_f"; } 2>/dev/null || : # no per-file
        case $sn_head in "$ELF_MAGIC"*) ;; *) continue ;; esac      # spawn
        LD_LIBRARY_PATH="$CHY_ROOT/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
            ldd "$sn_f" 2>/dev/null || :
    done | LC_ALL=C awk '$2 == "=>" && $3 == "not" && $4 == "found" { print $1 }' |
        LC_ALL=C sort -u | while IFS= read -r sn_s; do
            printf '%s%s\n' "$sn_s" "$(shlib_hint "$sn_s")"
        done
}

# Step 11: after linking, before the db write. Warnings only - they
# never affect exit and never undo the install; the files stay placed
# and linked, and the warning is the truth about what more the runtime
# needs.
verify_runtime() { # verify_runtime <name>
    if ! command -v ldd >/dev/null 2>&1; then
        warn "$1" 'ldd unavailable; runtime verification skipped'
        return 0
    fi
    scan_needs "$CHY_ROOT/store/$1-$R_VER" | while IFS= read -r vr_s; do
        warn "$1" "needs $vr_s"
    done
}

# --------------------------------------------------------------- remove --
# Prune directories that became empty, walking one unlinked path's parent
# chain upward; $CHY_ROOT's top-level entries themselves are never removed.
prune_up() { # prune_up <relative path>
    pr_d=$1
    while [ "${pr_d%/*}" != "$pr_d" ]; do
        pr_d=${pr_d%/*}
        case $pr_d in
            */*) rmdir "$CHY_ROOT/$pr_d" 2>/dev/null || return 0 ;;
            *)   return 0 ;;
        esac
    done
}

# Unlink every manifest path that is still a symlink owned by the
# package; anything missing or replaced gets a warning and is left alone.
unlink_links() { # unlink_links <name>
    ul_m=$CHY_ROOT/db/installed/$1/manifest
    [ -f "$ul_m" ] || return 0
    require "$1" readlink
    while IFS= read -r ul_p; do
        [ -n "$ul_p" ] || continue
        ul_f=$CHY_ROOT/$ul_p
        if [ -L "$ul_f" ]; then
            if [ "$(owner_of "$ul_f")" = "$1" ]; then
                rm -f "$ul_f"
                prune_up "$ul_p"
            else
                warn "$1" "$ul_p is not owned by $1; left in place"
            fi
        elif [ -e "$ul_f" ]; then
            warn "$1" "$ul_p was replaced; left in place"
        else
            warn "$1" "$ul_p is missing"
        fi
    done <"$ul_m"
}

# The installed packages whose db-recorded depends name $1 - the guard's
# evidence (makedepends never guard). $1 itself and the exempt set do not
# count. Output: byte-sorted, space-separated, trailing space if any.
requirers_of() { # requirers_of <name> <exempt-set>
    for ro_d in "$CHY_ROOT/db/installed/"*; do
        [ -f "$ro_d/depends" ] || continue
        ro_p=${ro_d##*/}
        [ "$ro_p" = "$1" ] && continue
        in_set "$ro_p" "$2" && continue
        if list_names "$ro_d/depends" | grep -Fqx "$1"; then
            printf '%s\n' "$ro_p"
        fi
    done | LC_ALL=C sort | tr '\n' ' '
}

do_remove() { # do_remove <name> - the package must be installed
    dr_db=$CHY_ROOT/db/installed/$1
    [ -f "$dr_db/version" ] || fail "$1" "db entry is corrupt: no version file"
    dr_ver='' dr_rev=''
    read -r dr_ver dr_rev <"$dr_db/version" || :
    [ -n "$dr_ver" ] || fail "$1" "db entry is corrupt: empty version file"
    unlink_links "$1"
    rm -f "$CHY_ROOT/store/$1"
    rm -rf "$CHY_ROOT/store/$1-$dr_ver"
    rm -rf "$dr_db"
    say "$1" "removed $dr_ver $dr_rev"
}

# -------------------------------------------------------------- install --
# The pipeline, in order. Any failure up to and including the
# conflict scan leaves the root exactly as it was: a failed rebuild never
# costs the working install.
do_install() { # do_install <name> <requested: 1|0>
    valid_name "$1" || fail "$1" "invalid package name"
    recipe_check "$1"                              # 1
    fetch_all "$1"                                 # 2
    prepare_build "$1"                             # 3
    run_build "$1"                                 # 4
    normalize "$1"                                 # 5
    conflict_scan "$1"                             # 6
    shape_check "$1"
    if [ -d "$CHY_ROOT/db/installed/$1" ]; then    # 7: reinstall - the old
        do_remove "$1"                             #    install goes only now
    fi
    say "$1" "link $1-$R_VER"
    mkdir -p "$CHY_ROOT/store"
    rm -rf "$CHY_ROOT/store/$1-$R_VER"
    mv "$NORM" "$CHY_ROOT/store/$1-$R_VER" ||      # 8: place the store entry
        fail "$1" "cannot place the store entry"
    rm -f "$CHY_ROOT/store/$1"
    ln -s "$1-$R_VER" "$CHY_ROOT/store/$1" ||      # 9: point the alias
        fail "$1" "cannot point the alias"
    link_farm "$1"                                 # 10
    verify_runtime "$1"                            # 11: warnings only
    write_db "$1" "$2"                             # 12
    say "$1" "installed $R_VER $R_REV"
}

# ------------------------------------------------------------- resolver --
# install resolution, steps 2-5. Scratch lives in build/resolve;
# resolution completes before any pipeline step wipes build/.
#
# Step 2: the needed set - walk depends+makedepends transitively from the
# requested names. A walked dependency is satisfied (joins nothing, its
# subtree not entered) when installed or provided; requested names never
# are. Step 3: every needed name must have a recipe.
resolve() { # resolve <space-separated requested names> - sets ORDER
    RES=$CHY_ROOT/build/resolve
    rm -rf "$RES"; mkdir -p "$RES"
    : >"$RES/edges"; : >"$RES/missing"

    NEEDED=" $1 " rv_seen=" $1 " REST=$1
    printf '%s\n' "$1" | tr ' ' '\n' >"$RES/needed"

    while pop; do
        rv_cur=$POP
        rv_dir=$CHY_ROOT/recipes/$rv_cur
        if [ ! -d "$rv_dir" ]; then       # a leaf: its needs are unknowable
            printf '%s\n' "$rv_cur" >>"$RES/missing"
            continue
        fi
        { list_names "$rv_dir/depends"
          list_names "$rv_dir/makedepends"; } >"$RES/deps"
        while IFS= read -r rv_d <&3; do
            valid_name "$rv_d" || fail "$rv_cur" "invalid dependency name: $rv_d"
            printf '%s %s\n' "$rv_cur" "$rv_d" >>"$RES/edges"
            in_set "$rv_d" "$rv_seen" && continue
            rv_seen="$rv_seen$rv_d "
            [ -d "$CHY_ROOT/db/installed/$rv_d" ] && continue # satisfied
            in_set "$rv_d" "$PROVIDED" && continue             # satisfied
            NEEDED="$NEEDED$rv_d " REST="$REST $rv_d"
            printf '%s\n' "$rv_d" >>"$RES/needed"
        done 3<"$RES/deps"
    done

    # Report the smallest missing name, once: blamed on "install" when it
    # was requested, else on its smallest needed requirer.
    if [ -s "$RES/missing" ]; then
        rv_m=$(LC_ALL=C sort "$RES/missing" | head -n 1)
        rv_by=install
        in_set "$rv_m" "$REQUESTED" || rv_by=$(awk -v m="$rv_m" \
            '$2 == m { print $1 }' "$RES/edges" | LC_ALL=C sort | head -n 1)
        fail "$rv_by" "needs $rv_m, which has no recipe and is not provided"
    fi

    resolve_conflicts
    ORDER=$(order_awk install) || case $? in
        3) fail install "dependency cycle: $ORDER" ;;
        *) fail install 'cannot order the needed set' ;;
    esac
}

# Step 4, three checks: a needed package's recipe conflicts with an
# installed one; an installed package's db-recorded conflicts with a
# needed one; a needed package's recipe conflicts with another needed
# one. Every violating pair prints one line - <name> the needed package,
# pairs sorted by <name> then <other>, the installed wording winning when
# both apply ("installed" < "needed" in byte order does that for free).
resolve_conflicts() {
    : >"$RES/pairs"
    while IFS= read -r rc_n <&3; do
        list_names "$CHY_ROOT/recipes/$rc_n/conflicts" >"$RES/confl"
        while IFS= read -r rc_c <&4; do
            [ "$rc_c" = "$rc_n" ] && continue
            [ ! -d "$CHY_ROOT/db/installed/$rc_c" ] ||
                printf '%s %s installed\n' "$rc_n" "$rc_c" >>"$RES/pairs"
            ! in_set "$rc_c" "$NEEDED" ||
                printf '%s %s needed\n' "$rc_n" "$rc_c" >>"$RES/pairs"
        done 4<"$RES/confl"
    done 3<"$RES/needed"

    for rc_d in "$CHY_ROOT/db/installed/"*; do
        [ -f "$rc_d/conflicts" ] || continue
        rc_i=${rc_d##*/}
        list_names "$rc_d/conflicts" >"$RES/confl"
        while IFS= read -r rc_c <&3; do
            if [ "$rc_c" != "$rc_i" ] && in_set "$rc_c" "$NEEDED"; then
                printf '%s %s installed\n' "$rc_c" "$rc_i" >>"$RES/pairs"
            fi
        done 3<"$RES/confl"
    done

    [ -s "$RES/pairs" ] || return 0
    LC_ALL=C sort -u "$RES/pairs" | while read -r rc_n rc_o rc_k; do
        [ "$rc_n $rc_o" = "${rc_prev-}" ] && continue
        rc_prev="$rc_n $rc_o"
        rc_what="installed $rc_o"
        [ "$rc_k" != needed ] || rc_what="$rc_o, also in this install"
        err "$rc_n" "conflicts with $rc_what"
    done
    exit 1
}

# Step 5: order $RES/needed over the $RES/edges kept inside the set - the
# unique smallest valid sequence: repeatedly emit the byte-smallest name
# whose kept dependencies have all been emitted. A stall means a cycle:
# under install, print the cycle from its smallest member and exit 3;
# under cascade (remove -r), drop that member's cycle edge and carry on.
order_awk() { # order_awk <install|cascade>
    LC_ALL=C sort -o "$RES/needed" "$RES/needed"
    LC_ALL=C awk -v mode="$1" '
        # Shortest live path a => b, breadth-first, smaller names claimed
        # first within a hop; "" when unreachable, "a" when a == b.
        function find_path(a, b,    qh, qt, q, cur, m, arr, k, w, out) {
            if (a == b) return a
            gen++; vis[a] = gen
            qh = 1; qt = 1; q[1] = a
            while (qh <= qt) {
                cur = q[qh++]
                m = split(adj[cur], arr, " ")
                for (k = 1; k <= m; k++) {
                    w = arr[k]
                    if (w == "" || !live[cur, w] || done[w] || vis[w] == gen)
                        continue
                    vis[w] = gen; par[w] = cur; q[++qt] = w
                }
            }
            if (vis[b] != gen) return ""
            out = b
            for (cur = b; cur != a; cur = par[cur]) out = par[cur] " -> " out
            return out
        }
        # The byte-smallest live neighbour of c that leads back to c -
        # "" unless c lies on a cycle.
        function hop(c,    m, arr, k, w, best) {
            best = ""
            m = split(adj[c], arr, " ")
            for (k = 1; k <= m; k++) {
                w = arr[k]
                if (w == "" || !live[c, w] || done[w]) continue
                if (best != "" && w >= best) continue
                if (find_path(w, c) != "") best = w
            }
            return best
        }
        NR == FNR { if (!($1 in need)) { need[$1] = 1; names[++n] = $1 }; next }
        ($1 in need) && ($2 in need) && !(($1, $2) in live) {
            live[$1, $2] = 1
            cnt[$1]++
            adj[$1] = adj[$1] " " $2
            rdep[$2] = rdep[$2] " " $1
        }
        END {                # names[] arrives byte-sorted (sort -o above)
            emitted = 0
            while (emitted < n) {
                pick = ""
                for (i = 1; i <= n; i++)
                    if (!done[names[i]] && cnt[names[i]] == 0) {
                        pick = names[i]; break
                    }
                if (pick != "") {
                    done[pick] = 1; ord[++emitted] = pick
                    m = split(rdep[pick], arr, " ")
                    for (k = 1; k <= m; k++)
                        if (arr[k] != "" && live[arr[k], pick]) cnt[arr[k]]--
                    continue
                }
                w = ""                       # stalled: a cycle exists
                for (i = 1; i <= n; i++) {   # its smallest on-cycle name
                    s = names[i]
                    if (!done[s] && (w = hop(s)) != "") break
                }
                if (w == "") exit 4          # cannot happen: stall => cycle
                if (mode == "install") {
                    printf "%s -> %s", s, find_path(w, s)
                    exit 3
                }
                live[s, w] = 0               # cascade: break the cycle here
                cnt[s]--
            }
            for (i = 1; i <= n; i++) printf "%s%s", (i > 1 ? " " : ""), ord[i]
            print ""
        }
    ' "$RES/needed" "$RES/edges"
}

# ---------------------------------------------------------------- verbs --
cmd_install() {
    ci_nodeps=0
    if [ "${1-}" = --no-deps ]; then ci_nodeps=1; shift; fi
    [ "$#" -gt 0 ] || { usage >&2; exit 2; }

    # Resolution step 1: duplicates collapse (first occurrence wins); a
    # requested name the host provides is skipped with a warning; every
    # other requested name is never treated as satisfied.
    PROVIDED=" $(provided_names | tr '\n' ' ')"
    REQUESTED=' ' ci_seen=' ' ci_names=''
    for ci_n in "$@"; do
        case $ci_n in -*) usage >&2; exit 2 ;; esac
        valid_name "$ci_n" || fail "$ci_n" "invalid package name"
        in_set "$ci_n" "$ci_seen" && continue
        ci_seen="$ci_seen$ci_n "
        if in_set "$ci_n" "$PROVIDED"; then
            warn "$ci_n" 'provided by the host'
            continue
        fi
        REQUESTED="$REQUESTED$ci_n " ci_names="${ci_names:+$ci_names }$ci_n"
    done
    [ -n "$ci_names" ] || exit 0        # everything provided: no order line

    ORDER=$ci_names                     # --no-deps: steps 2-5 skipped,
    [ "$ci_nodeps" -eq 1 ] ||           # the order as given
        resolve "$ci_names"

    printf 'chy: order: %s\n' "$ORDER"
    REST=$ORDER
    while pop; do
        ci_req=0
        in_set "$POP" "$REQUESTED" && ci_req=1
        do_install "$POP" "$ci_req"
    done
}

# remove -r: the removal set starts as the named packages plus
# every unrequested installed package in their recorded-depends closure;
# then any non-named member some installed package outside the set still
# depends on is deleted, repeatedly, to a fixed point - so mutually-
# dependent orphans that only cite each other still go. db data only.
cascade_remove() {
    ca_named=' '
    for ca_n in "$@"; do
        valid_name "$ca_n" || fail "$ca_n" "invalid package name"
        [ -d "$CHY_ROOT/db/installed/$ca_n" ] || fail "$ca_n" "not installed"
        in_set "$ca_n" "$ca_named" || ca_named="$ca_named$ca_n "
    done
    RES=$CHY_ROOT/build/resolve
    rm -rf "$RES"; mkdir -p "$RES"

    ca_set=$ca_named ca_seen=$ca_named REST=$ca_named
    while pop; do                            # the recorded-depends closure
        list_names "$CHY_ROOT/db/installed/$POP/depends" >"$RES/deps"
        while IFS= read -r ca_d <&3; do
            in_set "$ca_d" "$ca_seen" && continue
            ca_seen="$ca_seen$ca_d "
            [ -d "$CHY_ROOT/db/installed/$ca_d" ] || continue
            REST="$REST $ca_d"
            [ -f "$CHY_ROOT/db/installed/$ca_d/requested" ] ||
                ca_set="$ca_set$ca_d "
        done 3<"$RES/deps"
    done

    while :; do                              # shrink to the fixed point
        ca_new=' ' REST=$ca_set
        while pop; do
            if ! in_set "$POP" "$ca_named"; then
                ca_by=$(requirers_of "$POP" "$ca_set")
                [ -n "$ca_by" ] && continue # pinned from outside: deleted
            fi
            ca_new="$ca_new$POP "
        done
        [ "$ca_new" = "$ca_set" ] && break
        ca_set=$ca_new
    done

    REST=$ca_named
    while pop; do                            # outsiders veto named removals
        ca_by=$(requirers_of "$POP" "$ca_set"); ca_by=${ca_by% }
        [ -z "$ca_by" ] || fail "$POP" "required by: $ca_by"
    done

    : >"$RES/needed"; : >"$RES/edges"        # set-internal recorded edges
    REST=$ca_set
    while pop; do
        printf '%s\n' "$POP" >>"$RES/needed"
        list_names "$CHY_ROOT/db/installed/$POP/depends" >"$RES/deps"
        while IFS= read -r ca_d <&3; do
            if in_set "$ca_d" "$ca_set"; then
                printf '%s %s\n' "$POP" "$ca_d" >>"$RES/edges"
            fi
        done 3<"$RES/deps"
    done
    ca_ord=$(order_awk cascade) || fail remove 'cannot order the removal set'

    ca_rev='' REST=$ca_ord                   # remove in exact reverse order
    while pop; do ca_rev="$POP${ca_rev:+ $ca_rev}"; done
    REST=$ca_rev
    while pop; do do_remove "$POP"; done
}

cmd_remove() {
    cr_casc=0
    if [ "${1-}" = -r ]; then cr_casc=1; shift; fi
    [ "$#" -gt 0 ] || { usage >&2; exit 2; }
    for cr_n in "$@"; do
        case $cr_n in -*) usage >&2; exit 2 ;; esac
    done
    if [ "$cr_casc" -eq 1 ]; then cascade_remove "$@"; return 0; fi
    for cr_n in "$@"; do
        valid_name "$cr_n" || fail "$cr_n" "invalid package name"
        [ -d "$CHY_ROOT/db/installed/$cr_n" ] || fail "$cr_n" "not installed"
        cr_by=$(requirers_of "$cr_n" ' ')    # the guard, at this moment
        cr_by=${cr_by% }
        [ -z "$cr_by" ] || fail "$cr_n" "required by: $cr_by"
        do_remove "$cr_n"
    done
}

list_one() { # print "<name> <version> <revision>" from the db
    lo_v='' lo_r=''
    read -r lo_v lo_r <"$CHY_ROOT/db/installed/$1/version" || :
    printf '%s %s %s\n' "$1" "$lo_v" "$lo_r"
}

cmd_provided() {
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    provided_names
    exit 0
}

cmd_list() {
    for cl_n in "$@"; do
        case $cl_n in -*) usage >&2; exit 2 ;; esac
    done
    if [ "$#" -eq 0 ]; then
        for cl_d in "$CHY_ROOT/db/installed/"*; do
            [ -f "$cl_d/version" ] || continue
            list_one "${cl_d##*/}"
        done | LC_ALL=C sort
        exit 0
    fi
    cl_bad=0
    for cl_n in "$@"; do
        if ! valid_name "$cl_n"; then
            err "$cl_n" "invalid package name"
            cl_bad=1
        elif [ -f "$CHY_ROOT/db/installed/$cl_n/version" ]; then
            list_one "$cl_n"
        else
            err "$cl_n" "not installed"
            cl_bad=1
        fi
    done
    exit "$cl_bad"
}

# --------------------------------------------------------------- doctor --
# The truth report. Read-only: creates no directories, absent
# ones are empty. Per installed package in name order, three checks emit
# in order, at most one finding per manifest path: (1) the step-11 ELF
# scan over the store entry, (2) owned farm symlinks whose target does
# not resolve, (3) manifest drift - absent by lstat, or present but not
# our own symlink. Checks 2 and 3 walk the manifest in stored order.
doctor_scan() {
    dsc_ldd=1
    if ! command -v ldd >/dev/null 2>&1; then
        dsc_ldd=0
        warn doctor 'ldd unavailable; runtime verification skipped'
    fi
    for ds_d in "$CHY_ROOT/db/installed/"*; do
        [ -f "$ds_d/version" ] || continue
        printf '%s\n' "${ds_d##*/}"
    done | LC_ALL=C sort | while IFS= read -r ds_p; do
        ds_v='' ds_m=$CHY_ROOT/db/installed/$ds_p/manifest
        read -r ds_v _ <"$CHY_ROOT/db/installed/$ds_p/version" || :

        [ "$dsc_ldd" -eq 0 ] ||                    # 1: unresolved libraries
            scan_needs "$CHY_ROOT/store/$ds_p-$ds_v" |
                while IFS= read -r ds_s; do
                    printf 'chy: doctor: %s: needs %s\n' "$ds_p" "$ds_s"
                done

        [ -f "$ds_m" ] || continue
        while IFS= read -r ds_mp; do               # 2: broken farm links
            [ -n "$ds_mp" ] || continue
            [ -L "$CHY_ROOT/$ds_mp" ] || continue
            [ "$(owner_of "$CHY_ROOT/$ds_mp")" = "$ds_p" ] || continue
            [ -e "$CHY_ROOT/$ds_mp" ] ||
                printf 'chy: doctor: %s: broken link %s\n' "$ds_p" "$ds_mp"
        done <"$ds_m"
        while IFS= read -r ds_mp; do               # 3: manifest drift
            [ -n "$ds_mp" ] || continue
            if [ -L "$CHY_ROOT/$ds_mp" ]; then
                [ "$(owner_of "$CHY_ROOT/$ds_mp")" = "$ds_p" ] ||
                    printf 'chy: doctor: %s: foreign %s\n' "$ds_p" "$ds_mp"
            elif [ -e "$CHY_ROOT/$ds_mp" ]; then
                printf 'chy: doctor: %s: foreign %s\n' "$ds_p" "$ds_mp"
            else
                printf 'chy: doctor: %s: missing %s\n' "$ds_p" "$ds_mp"
            fi
        done <"$ds_m"
    done
}

cmd_doctor() {
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    require doctor readlink
    cd_out=$(doctor_scan)
    if [ -z "$cd_out" ]; then
        printf 'chy: doctor: clean\n'
        exit 0
    fi
    printf '%s\n' "$cd_out"
    printf 'chy: doctor: %s problem(s)\n' \
        "$(( $(printf '%s\n' "$cd_out" | wc -l) ))"
    exit 1
}

# ------------------------------------------------------------- dispatch --
check_root

case ${1-} in
    version)      printf '%s\n' "$CHY_VERSION" ;;
    ''|-h|--help) usage ;;
    install)      shift; cmd_install "$@" ;;
    remove)       shift; cmd_remove "$@" ;;
    list)         shift; cmd_list "$@" ;;
    provided)     shift; cmd_provided "$@" ;;
    doctor)       shift; cmd_doctor "$@" ;;
    *)            usage >&2; exit 2 ;;
esac
