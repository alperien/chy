#!/bin/sh
# chy. A tiny, source-based package manager for hand-built Linux systems.
# One POSIX shell script. No daemon, no root, and no state that isn't a
# plain file under $CHY_ROOT.
#
# install builds each package into store/<name>-<version>/, links it into
# the usr/ symlink farm, and records it under db/installed/. upgrade,
# remove, list, outdated, why, and doctor all work from that on-disk
# state. usage() lists the verbs.

CHY_VERSION=0.5.0

CR=$(printf '\r') # to strip from lines of hand-edited (DOS) recipe files

# output
# stdout: progress "-> <scope> <step>", results "+ <name> <ver>_<rev>"
# (installed) / "- ..." (removed); doctor and why lines carry no prefix.
# stderr: "chy: <name>: warning|error: <what>". On a tty with NO_COLOR unset
# only the sigils are tinted; piped stdout is byte-identical to plain, and
# stderr is never colored. main() sets the palette at startup.

step()    { printf '%s->%s %s %s\n' "$C_ARROW" "$C_OFF" "$1" "$2"; }
added()   { printf '%s+%s %s %s_%s\n' "$C_PLUS" "$C_OFF" "$1" "$2" "$3"; }
removed() { printf '%s-%s %s %s_%s\n' "$C_MINUS" "$C_OFF" "$1" "$2" "$3"; }
msg()  { printf 'chy: %s: %s: %s\n' "$1" "$2" "$3" >&2; }
warn() { msg "$1" warning "$2"; }
err()  { msg "$1" error "$2"; }
fail() { err "$1" "$2"; exit 1; }

usage() {
    cat <<EOF
chy $CHY_VERSION - a tiny package manager for hand-built Linux systems

usage:
  chy install [--no-deps] name...
                        resolve, fetch, verify, build, and link packages
  chy upgrade [name...] reinstall outdated packages; a soname bump also
                        rebuilds the installed dependents
  chy remove [-r] name...
                        unlink and delete packages; -r cascades orphans
  chy list [name...]    list installed packages
  chy outdated          report installed packages whose recipe moved
  chy why name...       explain why a package is installed
  chy provided          list host-provided package names
  chy doctor            report unresolved libraries and manifest drift
  chy version           print chy's version

\$CHY_ROOT selects the root (default: \$HOME/.chy).
EOF
}

# A verb that takes no flags rejects any leading-dash argument as an unknown
# flag: usage on stderr, exit 2.
no_opts() { # no_opts <args>
    for no_a in "$@"; do
        case $no_a in -*) usage >&2; exit 2 ;; esac
    done
}

# validation
# Package names match [A-Za-z0-9][A-Za-z0-9+._-]*. Versions and revisions match
# [A-Za-z0-9._+]+ (no hyphen, so store/<name>-<version> parses cleanly).
# "install", "order", and "rebuild" are reserved: they're scopes in the
# "-> <scope> ..." stdout grammar, so a package named that would be ambiguous.

valid_name() {
    case $1 in ''|[!A-Za-z0-9]*|install|order|rebuild) return 1 ;; esac
    case ${1#?} in *[!A-Za-z0-9+._-]*) return 1 ;; *) return 0 ;; esac
}

valid_version() {
    case $1 in ''|*[!A-Za-z0-9._+]*) return 1 ;; *) return 0 ;; esac
}

valid_sha256() {
    [ "${#1}" -eq 64 ] || return 1
    case $1 in *[!0-9a-f]*) return 1 ;; *) return 0 ;; esac
}

# The root has to be absolute, no whitespace, no . or .. components.
# Trailing slashes get stripped, anything else is refused at startup.
bad_root() {
    printf 'chy: invalid CHY_ROOT %s: %s\n' "${CHY_ROOT_RAW:-(empty)}" "$1" >&2
    exit 2
}

check_root() {
    if [ -z "${CHY_ROOT:-}" ]; then
        [ -n "${HOME:-}" ] || { CHY_ROOT_RAW=; bad_root 'unset, and HOME is unset'; }
        CHY_ROOT=$HOME/.chy
    fi
    CHY_ROOT_RAW=$CHY_ROOT   # what the user set, for diagnostics before we mutate it
    while [ "${CHY_ROOT%/}" != "$CHY_ROOT" ]; do CHY_ROOT=${CHY_ROOT%/}; done
    case $CHY_ROOT in /*) ;; *) bad_root 'not an absolute path' ;; esac
    case $CHY_ROOT in *[[:space:]]*) bad_root 'contains whitespace' ;; esac
    case $CHY_ROOT/ in */./*|*/../*) bad_root 'has . or .. components' ;; esac
}

# tools get checked the first time they're needed
require() { # require <name> <tool>
    command -v "$2" >/dev/null 2>&1 || fail "$1" "missing tool: $2"
}

# Significant lines of a list-valued recipe file: skip blanks and '#'
# comments. The test runs on the whitespace-trimmed line, so an indented '#'
# is a comment too and an all-whitespace line is blank.
sig_lines() {
    while IFS= read -r sl_line || [ -n "$sl_line" ]; do
        sl_line=${sl_line%"$CR"}
        sl_bare=${sl_line#"${sl_line%%[![:space:]]*}"}
        case $sl_bare in ''|'#'*) continue ;; esac
        printf '%s\n' "$sl_line"
    done <"$1"
}

first_field() { # print the first whitespace-separated field of $1
    ff_first=
    read -r ff_first _ <<EOF || :
$1
EOF
    printf '%s\n' "$ff_first"
}

sha_of() { # print the sha256 digest of a file
    sha_out=$(sha256sum <"$1") || return 1 # stdin: never a filename to escape
    printf '%s\n' "${sha_out%%[[:space:]]*}"
}

# Name sets are strings like " a b c ". Names never contain whitespace,
# so a case match does membership and the resolver needs no arrays.
in_set() { # in_set <name> <set>
    case $2 in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

# Walking a set: `REST=$set; while pop; do ... $POP ... done`. pop takes
# the first name of $REST into $POP, returns false when empty. Don't
# nest walks.
pop() {
    REST=${REST# }
    [ -n "$REST" ] || return 1
    case $REST in
        *' '*) POP=${REST%% *} REST=${REST#* } ;;
        *)     POP=$REST REST= ;;
    esac
}

# First field of every significant line; a missing file is an empty list.
list_names() { # list_names <file>
    [ -f "$1" ] || return 0
    sig_lines "$1" | while IFS= read -r ln_l; do first_field "$ln_l"; done
}

provided_names() { # db/provided names: sorted, de-duplicated
    list_names "$CHY_ROOT/db/provided" | LC_ALL=C sort -u
}

installed_names() { # entries under db/installed, byte-sorted
    for il_d in "$CHY_ROOT/db/installed/"*; do    # a dir here means installed
        [ -d "$il_d" ] || continue
        printf '%s\n' "${il_d##*/}"
    done | LC_ALL=C sort
}

# recipes
# overlay/<name>/ shadows recipes/<name>/ as a whole directory, never per file.
# An invalid overlay fails loudly; it never falls back to the corpus.
recipe_dir() { # recipe_dir <name>: the overlay dir if present, else the corpus dir
    rd_d=$CHY_ROOT/overlay/$1
    [ -d "$rd_d" ] || rd_d=$CHY_ROOT/recipes/$1
    printf '%s\n' "$rd_d"
}

# Check the recipe dir and set R_DIR, R_VER, R_REV. Anything invalid
# fails the install before any fetching starts.
recipe_check() { # recipe_check <name>
    R_DIR=$(recipe_dir "$1")
    [ -d "$R_DIR" ] || fail "$1" "no recipe for $1"
    for rc_f in version sources checksums build; do
        [ -f "$R_DIR/$rc_f" ] || fail "$1" "recipe missing required file: $rc_f"
    done

    # kind: absent means source. binary is just a provenance marker, the
    # pipeline is identical (the launcher convention binds the recipe,
    # not chy). Anything else is an error naming the kind.
    if [ -f "$R_DIR/kind" ]; then
        rc_kind=
        read -r rc_kind <"$R_DIR/kind" || :
        rc_kind=${rc_kind%"$CR"}
        case $rc_kind in source|binary) ;;
            *) fail "$1" "unsupported kind: ${rc_kind:-(empty)}" ;;
        esac
    fi

    # version: one line, "<version>" or "<version> <revision>".
    R_VER='' R_REV=''
    read -r R_VER R_REV <"$R_DIR/version" || :
    R_VER=${R_VER%"$CR"} R_REV=${R_REV%"$CR"}
    [ -n "$R_REV" ] || R_REV=1
    valid_version "$R_VER" || fail "$1" "invalid version: '$R_VER'"
    valid_version "$R_REV" || fail "$1" "invalid revision: '$R_REV'"

    # sources and checksums pair line for line, by ordinal.
    rc_nsrc=$(( $(sig_lines "$R_DIR/sources" | wc -l) ))
    rc_nsum=$(( $(sig_lines "$R_DIR/checksums" | wc -l) ))
    [ "$rc_nsrc" -gt 0 ] || fail "$1" "sources lists no sources"
    [ "$rc_nsrc" -eq "$rc_nsum" ] ||
        fail "$1" "sources/checksums line counts differ ($rc_nsrc vs $rc_nsum)"

    sig_lines "$R_DIR/checksums" | while IFS= read -r rc_line; do
        valid_sha256 "$(first_field "$rc_line")" || exit 1
    done || fail "$1" "checksums must be lowercase sha256 hex digests"
    # FIXME: names the recipe but not which checksums line is bad

    # Every source line needs a filename; no two lines can share one.
    sig_lines "$R_DIR/sources" | while IFS= read -r rc_line; do
        rc_url=$(first_field "$rc_line")
        [ -n "${rc_url##*/}" ] || exit 1
    done || fail "$1" "a sources line has no usable filename"
    rc_dup=$(
        sig_lines "$R_DIR/sources" | while IFS= read -r rc_line; do
            rc_url=$(first_field "$rc_line")
            printf '%s\n' "${rc_url##*/}"
        done | LC_ALL=C sort | uniq -d
    )
    [ -z "$rc_dup" ] ||
        fail "$1" "duplicate source filename: $(printf '%s\n' "$rc_dup" | head -n 1)"
}

# recipe_check's version parse without the validation, for the read verbs:
# line 1 ("<version>" or "<version> <revision>"), CR-stripped, into VQ_VER and
# VQ_REV. Unreadable tokens stay empty; no revision default (a db version
# always has both tokens, so only recipe readers default theirs).
read_version() { # read_version <file>
    VQ_VER='' VQ_REV=''
    [ -f "$1" ] || return 0
    read -r VQ_VER VQ_REV <"$1" || :
    VQ_VER=${VQ_VER%"$CR"} VQ_REV=${VQ_REV%"$CR"}
}

# fetch
fetch_url() { # fetch_url <name> <url> <outfile>
    if command -v curl >/dev/null 2>&1; then
        curl -fL -o "$3" -- "$2"
    elif command -v wget >/dev/null 2>&1; then
        wget -O "$3" -- "$2"
    else
        fail "$1" 'missing tool: curl or wget'
    fi
}

# One source line. A verified cache hit is used as-is; otherwise try the line's
# URLs in order (download, verify, on mismatch delete and move on), so a
# corrupt primary falls back to the mirror.
fetch_source() { # fetch_source <name> <sha256> <source line>
    fs_file=$(first_field "$3")
    fs_file=${fs_file##*/}
    fs_cache=$CHY_ROOT/cache/$fs_file
    step "$1" "fetch $fs_file"
    require "$1" sha256sum
    if [ -f "$fs_cache" ] && [ "$(sha_of "$fs_cache")" = "$2" ]; then
        return 0
    fi
    rm -f "$fs_cache"
    mkdir -p "$CHY_ROOT/cache"
    fs_rest=$3 fs_got='' fs_any=0
    while [ -n "$fs_rest" ]; do
        fs_url=${fs_rest%%[[:space:]]*}
        if [ "$fs_url" = "$fs_rest" ]; then
            fs_rest=
        else
            fs_rest=${fs_rest#*[[:space:]]}
        fi
        [ -n "$fs_url" ] || continue
        if fetch_url "$1" "$fs_url" "$fs_cache"; then
            fs_any=1 fs_got=$(sha_of "$fs_cache")
            [ "$fs_got" = "$2" ] && return 0
        fi
        rm -f "$fs_cache"
    done
    # A checksum mismatch and a dead network are different faults; name
    # whichever happened, don't blame the recipe for an outage.
    [ "$fs_any" -eq 1 ] ||
        fail "$1" "cannot download $fs_file from any listed source"
    fail "$1" "checksum mismatch for $fs_file: expected $2, got $fs_got"
}

# fetch and verify every source before the build dir is prepared
fetch_all() { # fetch_all <name>
    # Every write here gets checked. An interrupted run can leave build as a
    # regular file or build/srcs as a directory; if those writes failed
    # quietly, the loop would never run and the build would use the cache
    # without ever verifying a checksum.
    mkdir -p "$CHY_ROOT/build" || fail "$1" "cannot create the build dir"
    sig_lines "$R_DIR/sources"   >"$CHY_ROOT/build/srcs" ||
        fail "$1" "cannot stage the source list"
    sig_lines "$R_DIR/checksums" >"$CHY_ROOT/build/sums" ||
        fail "$1" "cannot stage the checksum list"
    while IFS= read -r fa_line <&3 && IFS= read -r fa_sum <&4; do
        fetch_source "$1" "$(first_field "$fa_sum")" "$fa_line"
    done 3<"$CHY_ROOT/build/srcs" 4<"$CHY_ROOT/build/sums"
}

# build dir
is_archive() {
    case $1 in *.tar.gz|*.tgz|*.tar.xz|*.tar.bz2) return 0 ;; *) return 1 ;; esac
}

# extract (known archives) or copy (anything else) one fetched source
# into the build dir.
stage_source() { # stage_source <name> <filename> <dir>
    ss_cache=$CHY_ROOT/cache/$2
    if is_archive "$2"; then
        require "$1" tar
        # Refuse absolute or parent-traversing members before extracting:
        # don't let a hostile archive out of the build dir, and not every
        # tar enforces that itself.
        tar -tf "$ss_cache" 2>/dev/null | while IFS= read -r ss_m; do
            case $ss_m in /*|../*|*/../*|*/..|..) exit 1 ;; esac
        done || fail "$1" "unsafe path in archive $2; refusing to extract"
        tar -xf "$ss_cache" -C "$3" || fail "$1" "cannot extract $2"
    else
        cp "$ss_cache" "$3/" || fail "$1" "cannot copy $2 into the build dir"
    fi
}

# If extracting the first source left exactly one top-level entry (dotfiles
# count) and it's a directory, hoist its contents up a level so ./configure
# works from the top.
hoist() { # hoist <dir>
    h_count=0 h_only=
    for h_e in "$1"/* "$1"/.[!.]* "$1"/..?*; do
        { [ -e "$h_e" ] || [ -L "$h_e" ]; } || continue
        h_count=$((h_count + 1)) h_only=$h_e
    done
    if [ "$h_count" -ne 1 ] || [ ! -d "$h_only" ] || [ -L "$h_only" ]; then
        return 0
    fi
    h_tmp=$CHY_ROOT/build/.hoist   # scratch outside $1, so no source entry collides
    rm -rf "$h_tmp"
    mv "$h_only" "$h_tmp" || return 1
    for h_e in "$h_tmp"/* "$h_tmp"/.[!.]* "$h_tmp"/..?*; do
        { [ -e "$h_e" ] || [ -L "$h_e" ]; } || continue
        mv "$h_e" "$1/" || return 1
    done
    rmdir "$h_tmp"
}

# wipe scratch, stage every source (only the first gets hoisted), then
# apply patches/*.patch and *.diff as one list, byte order.
prepare_build() { # prepare_build <name>
    WORK=$CHY_ROOT/build/work
    DEST=$CHY_ROOT/build/dest
    rm -rf "$CHY_ROOT/build"
    mkdir -p "$WORK" "$DEST"

    sig_lines "$R_DIR/sources" >"$CHY_ROOT/build/srcs"
    pb_first=1
    while IFS= read -r pb_line; do
        pb_file=$(first_field "$pb_line")
        pb_file=${pb_file##*/}
        stage_source "$1" "$pb_file" "$WORK"
        if [ "$pb_first" -eq 1 ] && is_archive "$pb_file"; then
            hoist "$WORK" || fail "$1" "cannot hoist $pb_file"
        fi
        pb_first=0
    done <"$CHY_ROOT/build/srcs"

    for pb_p in "$R_DIR/patches/"*.patch "$R_DIR/patches/"*.diff; do
        [ -e "$pb_p" ] || continue
        printf '%s\n' "${pb_p##*/}"
    done | LC_ALL=C sort >"$CHY_ROOT/build/patchlist"
    while IFS= read -r pb_p; do
        require "$1" patch
        step "$1" "apply $pb_p"
        # TODO: -p1 is hardcoded; a few void patches want -p0 (libffi)
        (cd "$WORK" && patch -p1 <"$R_DIR/patches/$pb_p") ||
            fail "$1" "patch failed to apply: $pb_p"
    done <"$CHY_ROOT/build/patchlist"
}

# build
# sh <recipe dir>/build <destdir> <version>, cwd the prepared build dir, with
# the environment. A nonzero exit aborts the install.
run_build() { # run_build <name>
    step "$1" "build $1-$R_VER"
    (
        cd "$WORK" || exit 1
        CHY_PREFIX=$CHY_ROOT/usr
        PATH=$CHY_PREFIX/bin:$PATH
        CPPFLAGS="${CPPFLAGS:+$CPPFLAGS }-I$CHY_PREFIX/include"
        LDFLAGS="${LDFLAGS:+$LDFLAGS }-L$CHY_PREFIX/lib -Wl,-rpath,$CHY_PREFIX/lib"
        PKG_CONFIG_PATH="$CHY_PREFIX/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
        export CHY_ROOT CHY_PREFIX PATH CPPFLAGS LDFLAGS PKG_CONFIG_PATH
        exec sh "$R_DIR/build" "$DEST" "$R_VER"
    ) || fail "$1" "build failed"
}

# normalize
# The build staged a DESTDIR image of the real prefix at $DEST$CHY_ROOT.
# Check it and normalize it, still in scratch, to a
# $CHY_ROOT-relative tree at $NORM. The root is untouched on failure.
normalize() { # normalize <name>
    NORM=$CHY_ROOT/build/pkg
    n_bad=$CHY_ROOT/build/norm-failed
    rm -f "$n_bad"
    require "$1" readlink

    # Every staged path has to resolve under $DEST$CHY_ROOT. This loop also
    # catches newlines: one in a path splits off a fragment that can't start
    # with the prefix, so it hits the else and aborts. Don't turn it into
    # find -path, you'd lose that.
    find "$DEST" \( -type f -o -type l \) -print | while IFS= read -r n_p; do
        case $n_p in
            "$DEST$CHY_ROOT/"*) ;;
            *) err "$1" "staged outside the prefix (or a path contains a newline): ${n_p#"$DEST"}"
                true >"$n_bad" ;;
        esac
    done
    [ ! -e "$n_bad" ] || fail "$1" "build staged a path outside \$CHY_ROOT or containing a newline"

    if [ -z "$(find "$DEST$CHY_ROOT" \( -type f -o -type l \) -print 2>/dev/null)" ]; then
        fail "$1" "build installed nothing"
    fi

    find "$DEST" -type l -print | while IFS= read -r n_p; do
        n_t=$(readlink "$n_p")
        case $n_t in
            "$DEST"*)
                err "$1" "symlink baked with the staging path: ${n_p#"$DEST$CHY_ROOT/"} -> $n_t"
                true >"$n_bad" ;;
        esac
    done
    [ ! -e "$n_bad" ] || fail "$1" "symlink targets baked with \$1 (DESTDIR)"

    mv "$DEST$CHY_ROOT" "$NORM" || fail "$1" "cannot normalize the staged tree"
}

# linking
# A farm symlink is owned by <name> iff its target has chy's own shape: a run
# of ../ (from updots) then store/<name>/... . Matching store/ anywhere in the
# target would claim a foreign link that just passes through some directory
# called store, so the match anchors to the leading ../ run.
owner_of() { # owner_of <link>: print the owning component, if any
    oo_t=$(readlink "$1") || return 0
    while [ "${oo_t#../}" != "$oo_t" ]; do oo_t=${oo_t#../}; done
    case $oo_t in
        store/*) oo_t=${oo_t#store/} ;;
        *)       return 0 ;;
    esac
    printf '%s\n' "${oo_t%%/*}"
}

updots() { # print ../ once per directory level of a relative path
    ud_p=$1 ud_u=
    while [ "${ud_p#*/}" != "$ud_p" ]; do
        ud_p=${ud_p#*/}
        ud_u=../$ud_u
    done
    printf '%s\n' "$ud_u"
}

# Conflicts are found from the normalized tree before the store or farm is
# touched, so the install links completely or not at all: a needed file path
# has to be free or already our own symlink, a needed directory free or real.
conflict_scan() { # conflict_scan <name>
    LIST=$CHY_ROOT/build/files
    # This list decides what gets checked, linked, and recorded, so a
    # truncated one would silently install a subset. No pipeline: each stage
    # writes a file and its own exit status is checked, find's included (a
    # pipe would only report the last stage, and find is the one that fails
    # partway on an unreadable directory).
    cs_raw=$CHY_ROOT/build/rawfiles
    (cd "$NORM" && find . \( -type f -o -type l \) -print) >"$cs_raw" ||
        fail "$1" "cannot enumerate the staged tree"
    LC_ALL=C sort -o "$cs_raw" "$cs_raw" || fail "$1" "cannot enumerate the staged tree"
    sed 's|^\./||' "$cs_raw" >"$LIST" || fail "$1" "cannot enumerate the staged tree"
    # normalize already refused an empty build, so an empty list here means a
    # truncated find/sort (a full disk), never a real package.
    [ -s "$LIST" ] ||
        fail "$1" "internal error: empty file list for a non-empty build"

    while IFS= read -r cs_p; do
        cs_d=$cs_p
        while [ "${cs_d%/*}" != "$cs_d" ]; do
            cs_d=${cs_d%/*}
            printf '%s\n' "$cs_d"
        done
    done <"$LIST" | LC_ALL=C sort -u >"$CHY_ROOT/build/dirs" ||
        fail "$1" "cannot enumerate the staged directories"

    cs_bad=0
    while IFS= read -r cs_d; do
        cs_f=$CHY_ROOT/$cs_d
        if [ -L "$cs_f" ]; then
            cs_own=$(owner_of "$cs_f")
            err "$1" "conflict: $cs_d is a symlink${cs_own:+ (owned by $cs_own)}, needed as a directory"
            cs_bad=1
        elif [ -e "$cs_f" ] && [ ! -d "$cs_f" ]; then
            err "$1" "conflict: $cs_d exists and is not a directory"
            cs_bad=1
        fi
    done <"$CHY_ROOT/build/dirs"

    while IFS= read -r cs_p; do
        cs_f=$CHY_ROOT/$cs_p
        if [ -L "$cs_f" ]; then
            cs_own=$(owner_of "$cs_f")
            if [ "$cs_own" != "$1" ]; then
                err "$1" "conflict: $cs_p${cs_own:+ (owned by $cs_own)}"
                cs_bad=1
            fi
        elif [ -e "$cs_f" ]; then
            err "$1" "conflict: $cs_p"
            cs_bad=1
        fi
    done <"$LIST"

    [ "$cs_bad" -eq 0 ] || fail "$1" "conflicts found; nothing was linked"
}

# store/<name>-<version> has to be free or a replaceable real directory,
# store/<name> free or a symlink. Anything else is a name/version
# clash, so chy stops instead of guessing.
shape_check() { # shape_check <name>
    sc_e=$CHY_ROOT/store/$1-$R_VER
    if [ -L "$sc_e" ] || { [ -e "$sc_e" ] && [ ! -d "$sc_e" ]; }; then
        fail "$1" "store/$1-$R_VER exists and is not a package directory"
    fi
    sc_a=$CHY_ROOT/store/$1
    if [ -e "$sc_a" ] && [ ! -L "$sc_a" ]; then
        fail "$1" "store/$1 exists and is not an alias symlink"
    fi
}

# Make the store entry visible: real directories, then one relative symlink per
# file, pointing through the store/<name> alias.
link_farm() { # link_farm <name>: record each created link, nonzero on failure
    while IFS= read -r lf_p; do
        lf_d=${lf_p%/*}
        [ "$lf_d" = "$lf_p" ] || mkdir -p "$CHY_ROOT/$lf_d" || return 1
        rm -f "$CHY_ROOT/$lf_p"
        ln -s "$(updots "$lf_p")store/$1/$lf_p" "$CHY_ROOT/$lf_p" || return 1
        printf '%s\n' "$lf_p" >>"$CHY_ROOT/build/linked"
    done <"$LIST"
}

# Commit rollback helpers: an install links completely or not at all, so on
# failure we undo the new links, drop the new store entry, and restore the old
# alias and farm.
# ln -sfn: -f and -n are not POSIX but every target userland has them and they
# are the only correct replace here. The alias points at a directory, so
# "ln -sf" would follow it into the old package and "rm then ln" would strand
# it if the ln then failed; -n replaces without following, in one command.
point_alias() { # point_alias <name> <target>
    ln -sfn "$2" "$CHY_ROOT/store/$1"
}

restore_alias() { # restore_alias <name> <previous target, or empty>
    if [ -n "$2" ]; then point_alias "$1" "$2"
    else rm -f "$CHY_ROOT/store/$1"; fi
}

rollback_farm() { # remove the farm links this install created
    [ -f "$CHY_ROOT/build/linked" ] || return 0
    while IFS= read -r rb_p || [ -n "$rb_p" ]; do
        [ -n "$rb_p" ] || continue
        rm -f "$CHY_ROOT/$rb_p"
        prune_up "$rb_p"
    done <"$CHY_ROOT/build/linked"
}

relink_prev() { # re-link the previous install's paths this install clobbered
    rp_m=$CHY_ROOT/db/installed/$1/manifest
    [ -f "$rp_m" ] || return 0
    while IFS= read -r rp_p || [ -n "$rp_p" ]; do
        [ -n "$rp_p" ] || continue
        { [ -e "$CHY_ROOT/$rp_p" ] || [ -L "$CHY_ROOT/$rp_p" ]; } && continue
        rp_d=${rp_p%/*}
        [ "$rp_d" = "$rp_p" ] || mkdir -p "$CHY_ROOT/$rp_d"
        ln -s "$(updots "$rp_p")store/$1/$rp_p" "$CHY_ROOT/$rp_p" 2>/dev/null || :
    done <"$rp_m"
}

# Undo a commit that failed after the farm links landed: drop the new links
# and store entry, restore the old alias, and re-link the old farm.
commit_rollback() { # commit_rollback <name> <new store dir> <prev alias>
    rollback_farm "$1"
    rm -rf "$CHY_ROOT/store/$2"
    restore_alias "$1" "$3"
    relink_prev "$1"
}

# The soname set of an installed tree: the names a dependent resolves at
# runtime. A soname is a symlink under usr/lib/ or lib/, one path component,
# matching *.so or *.so.*. A real file backed by a soname link drops out in
# favour of the link; a real *.so no link backs stays in the set. Link
# targets have to be read for this: by name alone a compat soname like
# libbz2.so.1.0 looks exactly like a backing file.
soname_set() { # soname_set <store root>: stdin = farm-relative paths
    ss_scan=$CHY_ROOT/build/soname-scan
    true >"$ss_scan"
    while IFS= read -r ss_p || [ -n "$ss_p" ]; do
        case $ss_p in
            usr/lib/*) ss_b=${ss_p#usr/lib/} ;;
            lib/*)     ss_b=${ss_p#lib/} ;;
            *) continue ;;
        esac
        case $ss_b in */*) continue ;; esac             # one component only
        case $ss_b in *.so|*.so.*) ;; *) continue ;; esac
        ss_f=$1/$ss_p
        if [ -L "$ss_f" ]; then
            ss_t=$(readlink "$ss_f")
            printf 'l %s %s\n' "$ss_b" "${ss_t##*/}" >>"$ss_scan"
        elif [ -f "$ss_f" ]; then
            printf 'f %s\n' "$ss_b" >>"$ss_scan"
        fi
    done
    LC_ALL=C awk '
        # A link drops its target only when the link is versioned and the
        # target extends its name: libz.so.1 backs libz.so.1.2.3. A bare dev
        # link (libssl.so -> libssl.so.3) drops nothing, and neither does a
        # compat alias to another soname (libx.so.1 -> libx.so.2); their
        # targets are real sonames and stay in the set.
        $1 == "l" {
            sym[$2] = 1
            if ($2 ~ /\.so\./ && index($3, $2 ".") == 1) backed[$3] = 1
            next
        }
        $1 == "f" { file[$2] = 1 }
        END {
            for (n in sym)  print n
            for (n in file) if (!(n in backed)) print n
        }
    ' "$ss_scan" | LC_ALL=C sort -u
}

retire_prev() { # retire_prev <name> <prev version> <new store dir>
    rp_m=$CHY_ROOT/db/installed/$1/manifest
    if [ -f "$rp_m" ]; then
        # A soname the old tree provided and the new one doesn't is a bump.
        # Warn on every reinstall; record the name so cmd_upgrade rebuilds
        # the dependents. Both trees are still on disk here (the old store
        # dir goes at the end of this function), so soname_set can read links.
        soname_set "$CHY_ROOT/store/$1-$2" <"$rp_m" >"$CHY_ROOT/build/sos-old"
        soname_set "$CHY_ROOT/store/$3"    <"$LIST" >"$CHY_ROOT/build/sos-new"
        LC_ALL=C comm -23 "$CHY_ROOT/build/sos-old" "$CHY_ROOT/build/sos-new" |
            while IFS= read -r rp_s; do
                warn "$1" "soname bump: $rp_s"
                printf '%s\n' "$1" >>"$CHY_ROOT/build/bumped"
            done
        LC_ALL=C awk 'NR == FNR { keep[$0] = 1; next } !($0 in keep)' \
            "$LIST" "$rp_m" | while IFS= read -r rp_p || [ -n "$rp_p" ]; do
            [ -n "$rp_p" ] || continue
            [ -L "$CHY_ROOT/$rp_p" ] || continue
            [ "$(owner_of "$CHY_ROOT/$rp_p")" = "$1" ] || continue
            rm -f "$CHY_ROOT/$rp_p"
            prune_up "$rp_p"
        done
    fi
    [ "$2" = "$R_VER" ] || rm -rf "$CHY_ROOT/store/$1-$2"
    rm -rf "$CHY_ROOT/db/installed/$1"
}

# The db entry is what makes a package installed. depends and conflicts come
# from the recipe; the empty requested marker means "named on the command
# line". stage_db assembles the entry under a temp name, checking every write,
# and runs before the old entry is retired, so a full disk still rolls back to
# a working install. commit_db publishes it with one rename, pipeline step 11.
# The entry is whole or absent, a package can't end up placed but unrecorded.
stage_db() { # stage_db <name> <requested: 1|0>
    wd_new=$CHY_ROOT/db/installed/.$1.new
    { rm -rf "$wd_new" && mkdir -p "$wd_new"; } || return 1
    printf '%s %s\n' "$R_VER" "$R_REV" >"$wd_new/version" || return 1
    cp "$LIST" "$wd_new/manifest" || return 1
    [ ! -f "$R_DIR/depends" ] || cp "$R_DIR/depends" "$wd_new/depends" || return 1
    [ ! -f "$R_DIR/conflicts" ] ||
        cp "$R_DIR/conflicts" "$wd_new/conflicts" || return 1
    [ "$2" -ne 1 ] || true >"$wd_new/requested" || return 1
}

commit_db() { # commit_db <name>: publish the staged entry atomically
    rm -rf "$CHY_ROOT/db/installed/$1" &&
        mv "$CHY_ROOT/db/installed/.$1.new" "$CHY_ROOT/db/installed/$1"
}

# runtime verification
# The ELF scan: each ELF under $1 is run through ldd with $CHY_ROOT/usr/lib on
# LD_LIBRARY_PATH, so it sees what a launched program would. Output: the
# distinct unresolved sonames (ldd's "=> not found"), byte-sorted, each with
# shlib_hint appended.

ELF_MAGIC=$(printf '\177ELF')

shlib_hint() { # " (package: <pkg>)" when shlibs.map knows the soname
    [ -f "$CHY_ROOT/shlibs.map" ] || return 0
    sh_pkg=$(sig_lines "$CHY_ROOT/shlibs.map" |
        LC_ALL=C awk -v s="$1" 'NF >= 2 && $1 == s { print $2; exit }')
    [ -z "$sh_pkg" ] || printf ' (package: %s)\n' "$sh_pkg"
}

scan_needs() { # scan_needs <store entry dir>
    [ -d "$1" ] || return 0
    # Skip sonames the package ships itself (they resolve at runtime via
    # the launcher or a source ELF's own rpath). -L -type f: only a
    # soname resolving to a real file counts; a dangling symlink provides
    # nothing and shouldn't hide a real "not found".
    sn_own=$(find -L "$1" -type f -name '*.so*' 2>/dev/null |
        while IFS= read -r sn_o; do printf '%s\n' "${sn_o##*/}"; done |
        LC_ALL=C sort -u)
    # The shell reads the ELF magic itself, so there's no per-file spawn.
    find "$1" -type f -print | while IFS= read -r sn_f; do
        sn_head=
        { IFS= read -r sn_head <"$sn_f"; } 2>/dev/null || :
        case $sn_head in "$ELF_MAGIC"*) ;; *) continue ;; esac
        LD_LIBRARY_PATH="$CHY_ROOT/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
            ldd "$sn_f" 2>&1 || :
    done | LC_ALL=C awk '
        $2 == "=>" && $3 == "not" && $4 == "found" { print $1 }
        # a candidate that exists but is not a loadable ELF makes the
        # loader abort instead of printing "=> not found"; recover the
        # offending soname from that message so it is not silently lost.
        /: error while loading shared libraries: / {
            elp = $0
            sub(/^.*error while loading shared libraries: /, "", elp)
            sub(/:.*$/, "", elp)
            nseg = split(elp, seg, "/")
            print seg[nseg]
        }' |
        LC_ALL=C sort -u | while IFS= read -r sn_s; do
            printf '%s\n' "$sn_own" | LC_ALL=C grep -qxF -- "$sn_s" && continue
            printf '%s%s\n' "$sn_s" "$(shlib_hint "$sn_s")"
        done
}

# Step 12: after the db write, so a kill during the long ldd pass can't
# leave a placed-but-unrecorded package. Warnings only, they never affect
# exit or undo the install.
verify_runtime() { # verify_runtime <name>
    if ! command -v ldd >/dev/null 2>&1; then
        warn "$1" 'ldd unavailable; runtime verification skipped'
        return 0
    fi
    scan_needs "$CHY_ROOT/store/$1-$R_VER" | while IFS= read -r vr_s; do
        warn "$1" "needs $vr_s"
    done
}

# remove
# Prune directories that became empty, walking one unlinked path's parent
# chain upward. $CHY_ROOT's top-level entries themselves are never removed.
prune_up() { # prune_up <relative path>
    pr_d=$1
    while [ "${pr_d%/*}" != "$pr_d" ]; do
        pr_d=${pr_d%/*}
        case $pr_d in
            */*) rmdir "$CHY_ROOT/$pr_d" 2>/dev/null || return 0 ;;
            *)   return 0 ;;
        esac
    done
}

# Unlink every manifest path that is still a symlink owned by the
# package; anything missing or replaced gets a warning and is left alone.
unlink_links() { # unlink_links <name>
    ul_m=$CHY_ROOT/db/installed/$1/manifest
    [ -f "$ul_m" ] || return 0
    require "$1" readlink
    while IFS= read -r ul_p || [ -n "$ul_p" ]; do
        [ -n "$ul_p" ] || continue
        ul_f=$CHY_ROOT/$ul_p
        if [ -L "$ul_f" ]; then
            if [ "$(owner_of "$ul_f")" = "$1" ]; then
                rm -f "$ul_f"
                prune_up "$ul_p"
            else
                warn "$1" "$ul_p is not owned by $1; left in place"
            fi
        elif [ -e "$ul_f" ]; then
            warn "$1" "$ul_p was replaced; left in place"
        else
            warn "$1" "$ul_p is missing"
        fi
    done <"$ul_m"
}

# Installed packages whose db-recorded depends name $1 (makedepends
# never guard). $1 itself and the exempt set don't count. Output:
# byte-sorted, space-separated, trailing space if any.
requirers_of() { # requirers_of <name> <exempt-set>
    for ro_d in "$CHY_ROOT/db/installed/"*; do
        [ -f "$ro_d/depends" ] || continue
        ro_p=${ro_d##*/}
        [ "$ro_p" = "$1" ] && continue
        in_set "$ro_p" "$2" && continue
        if list_names "$ro_d/depends" | grep -Fqx "$1"; then
            printf '%s\n' "$ro_p"
        fi
    done | LC_ALL=C sort | tr '\n' ' '
}

do_remove() { # do_remove <name>; the package must be installed
    dr_db=$CHY_ROOT/db/installed/$1
    [ -f "$dr_db/version" ] || fail "$1" "db entry is corrupt: no version file"
    dr_ver='' dr_rev=''
    read -r dr_ver dr_rev <"$dr_db/version" || :
    [ -n "$dr_ver" ] || fail "$1" "db entry is corrupt: empty version file"
    unlink_links "$1"
    rm -f "$CHY_ROOT/store/$1"
    rm -rf "$CHY_ROOT/store/$1-$dr_ver"
    rm -rf "$dr_db"
    removed "$1" "$dr_ver" "$dr_rev"
}

# install
# The pipeline, in order. Any failure up to and including the shape check
# (steps 1-6) leaves the root as it was, and the commit steps that follow
# roll back on failure, so a failed rebuild never costs the working install.
do_install() { # do_install <name> <requested: 1|0>
    valid_name "$1" || fail "$1" "invalid package name"
    recipe_check "$1"                              # 1
    fetch_all "$1"                                 # 2
    prepare_build "$1"                             # 3
    run_build "$1"                                 # 4
    normalize "$1"                                 # 5
    conflict_scan "$1"                             # 6
    shape_check "$1"
    # Commit, steps 8-11. The previous install stays intact until the new farm
    # links and db entry are both ready, so any failure here rolls back to it.
    # The trap is reinstalling the version that's already installed: the old
    # and new store entries share a name, and building onto it would destroy
    # the live install a failed commit is supposed to keep. That one case
    # stages the new tree under a temp name and swaps it in at the end.
    di_prevver=
    if [ -f "$CHY_ROOT/db/installed/$1/version" ]; then
        read -r di_prevver _ <"$CHY_ROOT/db/installed/$1/version" || :
        di_prevver=${di_prevver%"$CR"}
    fi
    di_alias=
    [ ! -L "$CHY_ROOT/store/$1" ] || di_alias=$(readlink "$CHY_ROOT/store/$1")

    di_store=$1-$R_VER di_samever=0
    if [ "$di_prevver" = "$R_VER" ] && [ -d "$CHY_ROOT/store/$1-$R_VER" ]; then
        di_samever=1 di_store=.$1-$R_VER.new
    fi

    step "$1" "link $1-$R_VER"
    mkdir -p "$CHY_ROOT/store"
    true >"$CHY_ROOT/build/linked"
    rm -rf "$CHY_ROOT/store/.$1-$R_VER.new"  # reclaim the temp a crash left.
                                             # Exact name, not a glob: a glob
                                             # would grab a sibling's temp too.
    # rm and mv guarded as one step. If the rm failed and left a directory,
    # mv would move the new tree inside it and exit 0 as if it had worked.
    if ! { rm -rf "$CHY_ROOT/store/$di_store" &&    # 8: place the store entry
           mv "$NORM" "$CHY_ROOT/store/$di_store"; }; then
        fail "$1" "cannot place the store entry"
    fi
    if ! point_alias "$1" "$di_store"; then          # 9: point the alias
        rm -rf "$CHY_ROOT/store/$di_store"
        restore_alias "$1" "$di_alias"
        fail "$1" "cannot point the alias"
    fi
    if ! link_farm "$1"; then                        # 10: link, with rollback
        commit_rollback "$1" "$di_store" "$di_alias"
        fail "$1" "cannot link the farm; rolled back"
    fi
    # Assemble the new db entry before retiring the old one, so a write
    # failure still leaves the previous install whole to roll back to.
    if ! stage_db "$1" "$2"; then
        commit_rollback "$1" "$di_store" "$di_alias"
        fail "$1" "cannot record the install; rolled back"
    fi

    [ -z "$di_prevver" ] || retire_prev "$1" "$di_prevver" "$di_store"  # safe now

    # Same-version reinstall: the new tree was staged under a temp name so
    # the old one survived the commit. retire_prev keeps the store dir in
    # this case (its version matches), so drop it now and swap the new tree
    # onto the canonical name and alias.
    if [ "$di_samever" -eq 1 ]; then
        # rm and mv guarded as one step, same reason as step 8: if the rm
        # failed, mv would bury the new tree inside the surviving old dir.
        if ! { rm -rf "$CHY_ROOT/store/$1-$R_VER" &&
               mv "$CHY_ROOT/store/$di_store" "$CHY_ROOT/store/$1-$R_VER"; }; then
            fail "$1" "cannot settle the store entry"
        fi
        point_alias "$1" "$1-$R_VER" || fail "$1" "cannot settle the alias"
    fi

    commit_db "$1" || fail "$1" "cannot record the install"  # 11: now installed
    verify_runtime "$1"                              # 12: warnings only
    added "$1" "$R_VER" "$R_REV"
}

# resolver
# install resolution, steps 2-5, in build/resolve (finished before any pipeline
# step wipes build/). Step 2 walks depends+makedepends from the requested
# names; a dependency already installed or provided is satisfied and its
# subtree skipped, but a requested name never is. Step 3: every needed name
# has to have a recipe.
resolve() { # resolve <space-separated requested names>; sets ORDER
    RES=$CHY_ROOT/build/resolve
    rm -rf "$RES"; mkdir -p "$RES" || fail install "cannot create the build scratch"
    require install sort
    require install awk
    true >"$RES/edges"; true >"$RES/missing"

    NEEDED=" $1 " rv_seen=" $1 " REST=$1
    printf '%s\n' "$1" | tr ' ' '\n' >"$RES/needed"

    while pop; do
        rv_cur=$POP
        rv_dir=$(recipe_dir "$rv_cur")
        if [ ! -d "$rv_dir" ]; then       # a leaf: its needs are unknowable
            printf '%s\n' "$rv_cur" >>"$RES/missing"
            continue
        fi
        { list_names "$rv_dir/depends"
          list_names "$rv_dir/makedepends"; } >"$RES/deps"
        while IFS= read -r rv_d <&3; do
            valid_name "$rv_d" || fail "$rv_cur" "invalid dependency name: $rv_d"
            printf '%s %s\n' "$rv_cur" "$rv_d" >>"$RES/edges"
            in_set "$rv_d" "$rv_seen" && continue
            rv_seen="$rv_seen$rv_d "
            [ -d "$CHY_ROOT/db/installed/$rv_d" ] && continue # satisfied
            in_set "$rv_d" "$PROVIDED" && continue             # satisfied
            NEEDED="$NEEDED$rv_d " REST="$REST $rv_d"
            printf '%s\n' "$rv_d" >>"$RES/needed"
        done 3<"$RES/deps"
    done

    # Report the smallest missing name, once: blamed on "install" when it
    # was requested, else on its smallest needed requirer.
    if [ -s "$RES/missing" ]; then
        rv_m=$(LC_ALL=C sort "$RES/missing" | head -n 1)
        rv_by=install
        in_set "$rv_m" "$REQUESTED" || rv_by=$(awk -v m="$rv_m" \
            '($2 "") == (m "") { print $1 }' "$RES/edges" | LC_ALL=C sort | head -n 1)
        fail "$rv_by" "needs $rv_m, which has no recipe and is not provided"
    fi

    resolve_conflicts
    ORDER=$(order_awk install) || case $? in
        3) fail install "dependency cycle: $ORDER" ;;
        *) fail install 'cannot order the needed set' ;;
    esac
}

# Step 4 conflict checks: a needed recipe vs an installed package, an installed
# db-conflicts vs a needed one, and two needed recipes. One line per violating
# pair, sorted by name then other; a dual match takes the "installed" wording
# ("installed" < "needed" in byte order).
resolve_conflicts() {
    true >"$RES/pairs"
    while IFS= read -r rc_n <&3; do
        list_names "$(recipe_dir "$rc_n")/conflicts" >"$RES/confl"
        while IFS= read -r rc_c <&4; do
            [ "$rc_c" = "$rc_n" ] && continue
            # A bogus conflict name matches nothing, don't build a path from it.
            valid_name "$rc_c" || continue
            [ ! -d "$CHY_ROOT/db/installed/$rc_c" ] ||
                printf '%s %s installed\n' "$rc_n" "$rc_c" >>"$RES/pairs"
            ! in_set "$rc_c" "$NEEDED" ||
                printf '%s %s needed\n' "$rc_n" "$rc_c" >>"$RES/pairs"
        done 4<"$RES/confl"
    done 3<"$RES/needed"

    for rc_d in "$CHY_ROOT/db/installed/"*; do
        [ -f "$rc_d/conflicts" ] || continue
        rc_i=${rc_d##*/}
        list_names "$rc_d/conflicts" >"$RES/confl"
        while IFS= read -r rc_c <&3; do
            if [ "$rc_c" != "$rc_i" ] && in_set "$rc_c" "$NEEDED"; then
                printf '%s %s installed\n' "$rc_c" "$rc_i" >>"$RES/pairs"
            fi
        done 3<"$RES/confl"
    done

    [ -s "$RES/pairs" ] || return 0
    LC_ALL=C sort -u "$RES/pairs" | while read -r rc_n rc_o rc_k; do
        [ "$rc_n $rc_o" = "${rc_prev-}" ] && continue
        rc_prev="$rc_n $rc_o"
        rc_what="installed $rc_o"
        [ "$rc_k" != needed ] || rc_what="$rc_o, also in this install"
        err "$rc_n" "conflicts with $rc_what"
    done
    exit 1
}

# Step 5: order $RES/needed over the $RES/edges kept inside the set. Repeatedly
# emit the byte-smallest name whose kept dependencies are all emitted; that's
# the unique smallest valid sequence. A stall means a cycle: under install,
# print it from its smallest member and exit 3; under cascade (remove -r), drop
# that member's cycle edge and carry on.
order_awk() { # order_awk <install|cascade>
    # Byte-sort both inputs: names[] has to arrive in byte order, and a
    # byte-ordered edge list makes cycle-path tie-breaks deterministic
    # whatever the recipe line order. The sorts get checked so a failure
    # can't turn into a silently wrong order.
    LC_ALL=C sort -o "$RES/needed" "$RES/needed" || return 2
    LC_ALL=C sort -u -o "$RES/edges" "$RES/edges" || return 2
    LC_ALL=C awk -v mode="$1" '
        # Shortest live path a => b, breadth-first, smaller names claimed
        # first within a hop; "" when unreachable, "a" when a == b.
        function find_path(a, b,    qh, qt, q, cur, m, arr, k, w, out) {
            if ((a "") == (b "")) return a   # string compare: names like 1e2
            gen++; vis[a] = gen
            qh = 1; qt = 1; q[1] = a
            while (qh <= qt) {
                cur = q[qh++]
                m = split(adj[cur], arr, " ")
                for (k = 1; k <= m; k++) {
                    w = arr[k]
                    if (w == "" || !live[cur, w] || done[w] || vis[w] == gen)
                        continue
                    vis[w] = gen; par[w] = cur; q[++qt] = w
                }
            }
            if (vis[b] != gen) return ""
            out = b
            for (cur = b; (cur "") != (a ""); cur = par[cur]) out = par[cur] " -> " out
            return out
        }
        # The byte-smallest live neighbour of c that leads back to c;
        # "" unless c lies on a cycle.
        function hop(c,    m, arr, k, w, best) {
            best = ""
            m = split(adj[c], arr, " ")
            for (k = 1; k <= m; k++) {
                w = arr[k]
                if (w == "" || !live[c, w] || done[w]) continue
                if (best != "" && (w "") >= (best "")) continue
                if (find_path(w, c) != "") best = w
            }
            return best
        }
        NR == FNR { if (!($1 in need)) { need[$1] = 1; names[++n] = $1 }; next }
        ($1 in need) && ($2 in need) && !(($1, $2) in live) {
            live[$1, $2] = 1
            cnt[$1]++
            adj[$1] = adj[$1] " " $2
            rdep[$2] = rdep[$2] " " $1
        }
        END {                # names[] arrives byte-sorted (sort -o above)
            emitted = 0
            while (emitted < n) {
                pick = ""
                for (i = 1; i <= n; i++)
                    if (!done[names[i]] && cnt[names[i]] == 0) {
                        pick = names[i]; break
                    }
                if (pick != "") {
                    done[pick] = 1; ord[++emitted] = pick
                    m = split(rdep[pick], arr, " ")
                    for (k = 1; k <= m; k++)
                        if (arr[k] != "" && live[arr[k], pick]) cnt[arr[k]]--
                    continue
                }
                w = ""                       # stalled: a cycle exists
                for (i = 1; i <= n; i++) {   # its smallest on-cycle name
                    s = names[i]
                    if (!done[s] && (w = hop(s)) != "") break
                }
                if (w == "") exit 4          # cannot happen: stall => cycle
                if (mode == "install") {
                    printf "%s -> %s", s, find_path(w, s)
                    exit 3
                }
                live[s, w] = 0               # cascade: break the cycle here
                cnt[s]--
            }
            for (i = 1; i <= n; i++) printf "%s%s", (i > 1 ? " " : ""), ord[i]
            print ""
        }
    ' "$RES/needed" "$RES/edges"
}

# verbs
cmd_install() {
    ci_nodeps=0
    if [ "${1-}" = --no-deps ]; then ci_nodeps=1; shift; fi
    [ "$#" -gt 0 ] || { usage >&2; exit 2; }

    # Resolution step 1: duplicates collapse (first occurrence wins). A
    # requested name the host provides is skipped with a warning. No
    # other requested name ever counts as satisfied.
    PROVIDED=" $(provided_names | tr '\n' ' ')"
    REQUESTED=' ' ci_seen=' ' ci_names=''
    for ci_n in "$@"; do
        case $ci_n in -*) usage >&2; exit 2 ;; esac
        valid_name "$ci_n" || fail "$ci_n" "invalid package name"
        in_set "$ci_n" "$ci_seen" && continue
        ci_seen="$ci_seen$ci_n "
        if in_set "$ci_n" "$PROVIDED"; then
            warn "$ci_n" 'provided by the host'
            continue
        fi
        REQUESTED="$REQUESTED$ci_n " ci_names="${ci_names:+$ci_names }$ci_n"
    done
    [ -n "$ci_names" ] || exit 0        # everything provided: no order line

    # --no-deps skips resolution (steps 2-5) and installs in the given order.
    ORDER=$ci_names
    [ "$ci_nodeps" -eq 1 ] || resolve "$ci_names"

    step order "$ORDER"
    REST=$ORDER
    while pop; do
        ci_req=0
        in_set "$POP" "$REQUESTED" && ci_req=1
        do_install "$POP" "$ci_req"
    done
}

# remove -r: the removal set is the named packages plus every unrequested
# installed package in their recorded-depends closure. Then any non-named
# member some installed package outside the set still depends on is dropped,
# repeatedly, to a fixed point. Mutually dependent orphans that only cite each
# other still go. db data only.
cascade_remove() {
    ca_named=' '
    for ca_n in "$@"; do
        valid_name "$ca_n" || fail "$ca_n" "invalid package name"
        [ -d "$CHY_ROOT/db/installed/$ca_n" ] || fail "$ca_n" "not installed"
        in_set "$ca_n" "$ca_named" || ca_named="$ca_named$ca_n "
    done
    RES=$CHY_ROOT/build/resolve
    rm -rf "$RES"; mkdir -p "$RES" || fail remove "cannot create the build scratch"
    require remove sort
    require remove awk

    ca_set=$ca_named ca_seen=$ca_named REST=$ca_named
    while pop; do                            # the recorded-depends closure
        list_names "$CHY_ROOT/db/installed/$POP/depends" >"$RES/deps"
        while IFS= read -r ca_d <&3; do
            in_set "$ca_d" "$ca_seen" && continue
            ca_seen="$ca_seen$ca_d "
            [ -d "$CHY_ROOT/db/installed/$ca_d" ] || continue
            REST="$REST $ca_d"
            [ -f "$CHY_ROOT/db/installed/$ca_d/requested" ] ||
                ca_set="$ca_set$ca_d "
        done 3<"$RES/deps"
    done

    while :; do                              # shrink to the fixed point
        ca_new=' ' REST=$ca_set
        while pop; do
            if ! in_set "$POP" "$ca_named"; then
                ca_by=$(requirers_of "$POP" "$ca_set")
                [ -n "$ca_by" ] && continue # pinned from outside: dropped
            fi
            ca_new="$ca_new$POP "
        done
        [ "$ca_new" = "$ca_set" ] && break
        ca_set=$ca_new
    done

    REST=$ca_named
    while pop; do                            # outsiders veto named removals
        ca_by=$(requirers_of "$POP" "$ca_set"); ca_by=${ca_by% }
        [ -z "$ca_by" ] || fail "$POP" "required by: $ca_by"
    done

    true >"$RES/needed"; true >"$RES/edges"        # set-internal recorded edges
    REST=$ca_set
    while pop; do
        printf '%s\n' "$POP" >>"$RES/needed"
        list_names "$CHY_ROOT/db/installed/$POP/depends" >"$RES/deps"
        while IFS= read -r ca_d <&3; do
            if in_set "$ca_d" "$ca_set"; then
                printf '%s %s\n' "$POP" "$ca_d" >>"$RES/edges"
            fi
        done 3<"$RES/deps"
    done
    ca_ord=$(order_awk cascade) || fail remove 'cannot order the removal set'

    ca_rev='' REST=$ca_ord                   # remove in reverse order
    while pop; do ca_rev="$POP${ca_rev:+ $ca_rev}"; done
    REST=$ca_rev
    while pop; do do_remove "$POP"; done
}

cmd_remove() {
    cr_casc=0
    if [ "${1-}" = -r ]; then cr_casc=1; shift; fi
    [ "$#" -gt 0 ] || { usage >&2; exit 2; }
    no_opts "$@"
    if [ "$cr_casc" -eq 1 ]; then cascade_remove "$@"; return 0; fi
    for cr_n in "$@"; do
        valid_name "$cr_n" || fail "$cr_n" "invalid package name"
        [ -d "$CHY_ROOT/db/installed/$cr_n" ] || fail "$cr_n" "not installed"
        cr_by=$(requirers_of "$cr_n" ' ')    # the guard, at this moment
        cr_by=${cr_by% }
        [ -z "$cr_by" ] || fail "$cr_n" "required by: $cr_by"
        do_remove "$cr_n"
    done
}

list_one() { # print "<name> <version> <revision>" from the db
    lo_v='' lo_r=''
    read -r lo_v lo_r <"$CHY_ROOT/db/installed/$1/version" || :
    printf '%s %s %s\n' "$1" "$lo_v" "$lo_r"
}

cmd_provided() {
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    provided_names
    exit 0
}

cmd_list() {
    no_opts "$@"
    if [ "$#" -eq 0 ]; then
        for cl_d in "$CHY_ROOT/db/installed/"*; do
            [ -f "$cl_d/version" ] || continue
            list_one "${cl_d##*/}"
        done | LC_ALL=C sort
        exit 0
    fi
    cl_bad=0
    for cl_n in "$@"; do
        if ! valid_name "$cl_n"; then
            err "$cl_n" "invalid package name"
            cl_bad=1
        elif [ -f "$CHY_ROOT/db/installed/$cl_n/version" ]; then
            list_one "$cl_n"
        else
            err "$cl_n" "not installed"
            cl_bad=1
        fi
    done
    exit "$cl_bad"
}

# outdated
# The predicate: a package's db "<version> <revision>" isn't byte-equal to its
# recipe's (recipe revision defaulting to 1). Version files only, never full
# recipe_check, so one broken recipe can't sink a whole report. Sets OD_IV
# OD_IR OD_RV OD_RR, raw tokens, empty when unreadable.
version_drift() { # version_drift <name>: true when db and recipe differ
    read_version "$CHY_ROOT/db/installed/$1/version"
    OD_IV=$VQ_VER OD_IR=$VQ_REV
    read_version "$(recipe_dir "$1")/version"
    OD_RV=$VQ_VER OD_RR=$VQ_REV
    [ -n "$OD_RR" ] || OD_RR=1
    [ "$OD_IV $OD_IR" != "$OD_RV $OD_RR" ]
}

# Walk installed packages in name order: a provided or recipe-gone one
# is skipped with its warning, each drifted one prints the report
# line, unreadable tokens as "-". cmd_upgrade reads this walk for its
# no-name target set.
outdated_walk() {
    installed_names | while IFS= read -r od_n; do
        if in_set "$od_n" "$PROVIDED"; then
            warn "$od_n" 'provided by the host'
        elif [ ! -d "$(recipe_dir "$od_n")" ]; then
            warn "$od_n" 'no recipe'
        elif version_drift "$od_n"; then
            printf '%s %s %s -> %s %s\n' "$od_n" \
                "${OD_IV:--}" "${OD_IR:--}" "${OD_RV:--}" "${OD_RR:--}"
        fi
    done
}

cmd_outdated() { # read-only, like doctor; a report, so exit 0 always
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    PROVIDED=" $(provided_names | tr '\n' ' ')"
    outdated_walk
    exit 0
}

# why: explain each named package from the db alone. Names
# are processed like list, all of them in order. requested and
# required-by both print when both hold, requested first.
cmd_why() {
    [ "$#" -gt 0 ] || { usage >&2; exit 2; }
    no_opts "$@"
    cw_bad=0
    for cw_n in "$@"; do
        if ! valid_name "$cw_n"; then
            err "$cw_n" "invalid package name"
            cw_bad=1
            continue
        fi
        if [ ! -d "$CHY_ROOT/db/installed/$cw_n" ]; then
            err "$cw_n" "not installed"
            cw_bad=1
            continue
        fi
        cw_why=0
        if [ -f "$CHY_ROOT/db/installed/$cw_n/requested" ]; then
            printf '%s: %s\n' "$cw_n" 'requested'
            cw_why=1
        fi
        cw_by=$(requirers_of "$cw_n" ' ')
        cw_by=${cw_by% }
        if [ -n "$cw_by" ]; then
            printf '%s: %s\n' "$cw_n" "required by: $cw_by"
            cw_why=1
        fi
        [ "$cw_why" -eq 1 ] ||
            printf '%s: %s\n' "$cw_n" 'orphan (not requested, nothing requires it)'
    done
    exit "$cw_bad"
}

# doctor
# Read-only: creates no directories. Per installed package, in name order,
# three checks emit in stored manifest order: (1) the step-12 ELF scan, (2)
# broken owned farm links, (3) manifest drift (missing, or present but not our
# own symlink).
doctor_scan() {
    dsc_ldd=1
    if ! command -v ldd >/dev/null 2>&1; then
        dsc_ldd=0
        warn doctor 'ldd unavailable; runtime verification skipped'
    fi
    for ds_d in "$CHY_ROOT/db/installed/"*; do
        [ -d "$ds_d" ] || continue
        printf '%s\n' "${ds_d##*/}"
    done | LC_ALL=C sort | while IFS= read -r ds_p; do
        ds_m=$CHY_ROOT/db/installed/$ds_p/manifest
        # A well-formed entry has a readable version and a manifest; a half
        # written one (hand damage, or a kill in an older write path) has to
        # be reported, not skipped, or doctor calls a damaged root clean.
        if [ ! -f "$CHY_ROOT/db/installed/$ds_p/version" ]; then
            printf 'doctor: %s: corrupt db entry (no version)\n' "$ds_p"
            continue
        fi
        ds_v=''
        read -r ds_v _ <"$CHY_ROOT/db/installed/$ds_p/version" || :
        ds_v=${ds_v%"$CR"}
        if [ -z "$ds_v" ]; then
            printf 'doctor: %s: corrupt db entry (empty version)\n' "$ds_p"
            continue
        fi

        [ "$dsc_ldd" -eq 0 ] ||                    # 1: unresolved libraries
            scan_needs "$CHY_ROOT/store/$ds_p-$ds_v" |
                while IFS= read -r ds_s; do
                    printf 'doctor: %s: needs %s\n' "$ds_p" "$ds_s"
                done

        if [ ! -f "$ds_m" ]; then
            printf 'doctor: %s: corrupt db entry (no manifest)\n' "$ds_p"
            continue
        fi
        while IFS= read -r ds_mp || [ -n "$ds_mp" ]; do   # 2: broken farm links
            [ -n "$ds_mp" ] || continue
            [ -L "$CHY_ROOT/$ds_mp" ] || continue
            [ "$(owner_of "$CHY_ROOT/$ds_mp")" = "$ds_p" ] || continue
            [ -e "$CHY_ROOT/$ds_mp" ] ||
                printf 'doctor: %s: broken link %s\n' "$ds_p" "$ds_mp"
        done <"$ds_m"
        while IFS= read -r ds_mp || [ -n "$ds_mp" ]; do   # 3: manifest drift
            [ -n "$ds_mp" ] || continue
            if [ -L "$CHY_ROOT/$ds_mp" ]; then
                [ "$(owner_of "$CHY_ROOT/$ds_mp")" = "$ds_p" ] ||
                    printf 'doctor: %s: foreign %s\n' "$ds_p" "$ds_mp"
            elif [ -e "$CHY_ROOT/$ds_mp" ]; then
                printf 'doctor: %s: foreign %s\n' "$ds_p" "$ds_mp"
            else
                printf 'doctor: %s: missing %s\n' "$ds_p" "$ds_mp"
            fi
        done <"$ds_m"
    done
}

cmd_doctor() {
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    require doctor readlink
    cd_out=$(doctor_scan)
    if [ -z "$cd_out" ]; then
        printf 'doctor: clean\n'
        exit 0
    fi
    printf '%s\n' "$cd_out"
    printf 'doctor: %s problem(s)\n' \
        "$(( $(printf '%s\n' "$cd_out" | wc -l) ))"
    exit 1
}

# upgrade
# Reinstall drifted packages. The target set resolves and installs exactly as
# cmd_install; each keeps the requested marker it had, snapshotted up front
# because retire_prev drops the db entry mid-run. A reinstall that lost a
# soname left its name in build/bumped; the installed dependents of every
# bumped package are then rebuilt so nothing keeps NEEDing a dropped name.

is_binary_kind() { # is_binary_kind <name>: the recipe declares kind binary
    ik_f=$(recipe_dir "$1")/kind
    [ -f "$ik_f" ] || return 1
    ik_k=
    read -r ik_k <"$ik_f" || :
    [ "${ik_k%"$CR"}" = binary ]
}

# Resumability: a package left needing a soname the farm now
# carries at a different version (a same-stem sibling under usr/lib)
# was stranded by an interrupted bump rebuild; reinstalling relinks it
# clean. A need with no provider at all is host drift, doctor's to
# report, never rebuilt here.
needs_relink() { # needs_relink <store entry dir>
    nr_miss=$(scan_needs "$1")
    [ -n "$nr_miss" ] || return 1
    while IFS= read -r nr_l; do
        nr_s=$(first_field "$nr_l")     # scan lines may carry the map hint
        case $nr_s in                   # only a real soname has a sibling
            *.so)   nr_stem=${nr_s%.so} ;;
            *.so.*) nr_stem=${nr_s%%.so.*} ;;
            *)      continue ;;         # not soname-shaped: not a relink case
        esac
        # A versioned sibling at some other version means the farm moved under
        # this package, and a rebuild relinks it. The bare $stem.so is a
        # link-time dev symlink, not a runtime provider. A need whose only
        # farm entry is that, or nothing at all, is host drift; doctor
        # reports it and nothing gets rebuilt here.
        for nr_c in "$CHY_ROOT/usr/lib/$nr_stem".so.*; do
            [ -e "$nr_c" ] || continue  # dangling names provide nothing
            [ "${nr_c##*/}" = "$nr_s" ] || return 0
        done
    done <<EOF
$nr_miss
EOF
    return 1
}

# The ABI rebuild set: installed dependents of every bumped package,
# transitive over db-recorded depends (the remove guard's relation,
# makedepends never), minus everything already built this run. Printed
# in order over set-internal recorded edges; exit 3 carries a cycle.
rebuild_set() { # rebuild_set <bumped-set> <done-set>
    rb_seen=$1 rb_new=' '
    rb_q=${1# }
    while [ -n "$rb_q" ]; do
        case $rb_q in
            *' '*) rb_c=${rb_q%% *} rb_q=${rb_q#* } ;;
            *)     rb_c=$rb_q rb_q= ;;
        esac
        [ -n "$rb_c" ] || continue
        rb_r=$(requirers_of "$rb_c" ' ')
        while [ -n "$rb_r" ]; do
            rb_d=${rb_r%% *} rb_r=${rb_r#* }
            [ -n "$rb_d" ] || continue
            in_set "$rb_d" "$rb_seen" && continue
            rb_seen="$rb_seen$rb_d "
            rb_q="$rb_q${rb_q:+ }$rb_d"    # walk through excluded ones too
            in_set "$rb_d" "$2" && continue
            # An unbuildable dependent is warned and skipped; doctor will name
            # the soname it still needs.
            if in_set "$rb_d" "$PROVIDED"; then
                warn "$rb_d" 'provided by the host'
            elif [ ! -d "$(recipe_dir "$rb_d")" ]; then
                warn "$rb_d" 'no recipe'
            else
                rb_new="$rb_new$rb_d "
            fi
        done
    done
    [ "$rb_new" != ' ' ] || return 0

    RES=$CHY_ROOT/build/resolve
    rm -rf "$RES"; mkdir -p "$RES"
    true >"$RES/needed"; true >"$RES/edges"
    rb_q=${rb_new# }
    while [ -n "$rb_q" ]; do
        case $rb_q in
            *' '*) rb_c=${rb_q%% *} rb_q=${rb_q#* } ;;
            *)     rb_c=$rb_q rb_q= ;;
        esac
        [ -n "$rb_c" ] || continue
        printf '%s\n' "$rb_c" >>"$RES/needed"
        list_names "$CHY_ROOT/db/installed/$rb_c/depends" >"$RES/deps"
        while IFS= read -r rb_d <&3; do
            ! in_set "$rb_d" "$rb_new" ||
                printf '%s %s\n' "$rb_c" "$rb_d" >>"$RES/edges"
        done 3<"$RES/deps"
    done
    order_awk install
}

# Install every name of an ordered list, upgrade-style: the requested
# flag comes from the CU_MARK snapshot, and the bump record an install
# may leave is folded into CU_BUMP before the next build wipes it.
upgrade_run() { # upgrade_run <ordered names>
    REST=$1
    while pop; do
        ur_req=0
        in_set "$POP" "$CU_MARK" && ur_req=1
        do_install "$POP" "$ur_req"
        CU_DONE="$CU_DONE$POP "
        [ -f "$CHY_ROOT/build/bumped" ] || continue
        while IFS= read -r ur_b || [ -n "$ur_b" ]; do
            [ -n "$ur_b" ] || continue
            in_set "$ur_b" "$CU_BUMP" || CU_BUMP="$CU_BUMP$ur_b "
        done <"$CHY_ROOT/build/bumped"
        rm -f "$CHY_ROOT/build/bumped"
    done
}

cmd_upgrade() {
    no_opts "$@"
    PROVIDED=" $(provided_names | tr '\n' ' ')"

    CU_T=' ' cu_names=''
    if [ "$#" -eq 0 ]; then
        cu_out=$(outdated_walk) # every outdated package
        while IFS= read -r cu_l; do
            [ -n "$cu_l" ] || continue
            cu_n=$(first_field "$cu_l")
            CU_T="$CU_T$cu_n " cu_names="${cu_names:+$cu_names }$cu_n"
        done <<EOF
$cu_out
EOF
    else
        for cu_n in "$@"; do        # cascade discipline: every name is
            valid_name "$cu_n" || fail "$cu_n" "invalid package name"
            [ -d "$CHY_ROOT/db/installed/$cu_n" ] || fail "$cu_n" "not installed"
            [ -d "$(recipe_dir "$cu_n")" ] || fail "$cu_n" "no recipe"
        done                        # checked before anything is touched
        for cu_n in "$@"; do
            in_set "$cu_n" "$CU_T" && continue
            version_drift "$cu_n" || continue   # current: skipped silently
            CU_T="$CU_T$cu_n " cu_names="${cu_names:+$cu_names }$cu_n"
        done
    fi

    # Fold in packages a past interrupted run left dangling. Skipped
    # without ldd, which the scan needs; installs still verify (and
    # warn) on their own.
    if command -v ldd >/dev/null 2>&1; then
        cu_rep=$(installed_names | while IFS= read -r cu_n; do
            in_set "$cu_n" "$CU_T" && continue
            in_set "$cu_n" "$PROVIDED" && continue
            [ -d "$(recipe_dir "$cu_n")" ] || continue
            # Rebuilding a prebuilt package can't change what it NEEDs.
            is_binary_kind "$cu_n" && continue
            read_version "$CHY_ROOT/db/installed/$cu_n/version"
            [ -n "$VQ_VER" ] || continue
            if needs_relink "$CHY_ROOT/store/$cu_n-$VQ_VER"; then
                printf '%s\n' "$cu_n"
            fi
        done)
        while IFS= read -r cu_n; do
            [ -n "$cu_n" ] || continue
            CU_T="$CU_T$cu_n " cu_names="${cu_names:+$cu_names }$cu_n"
        done <<EOF
$cu_rep
EOF
    fi

    [ -n "$cu_names" ] || exit 0    # nothing drifted: print nothing

    CU_MARK=' ' REST=$cu_names      # snapshot the requested markers now;
    while pop; do                   # retire_prev eats the db mid-run
        [ ! -f "$CHY_ROOT/db/installed/$POP/requested" ] ||
            CU_MARK="$CU_MARK$POP "
    done

    REQUESTED=$CU_T                 # resolver blame stays install-scoped
    resolve "$cu_names"
    step order "$ORDER"
    CU_DONE=' ' CU_BUMP=' '
    upgrade_run "$ORDER"

    cu_said=0                       # the ABI rebuild rounds: dependents
    while :; do                     # of every bump, at most once each
        cu_batch=$(rebuild_set "$CU_BUMP" "$CU_DONE") || case $? in
            3) fail install "dependency cycle: $cu_batch" ;;
            *) fail install 'cannot order the rebuild set' ;;
        esac
        [ -n "$cu_batch" ] || break
        if [ "$cu_said" -eq 0 ]; then
            step rebuild "$cu_batch"
            cu_said=1
        fi
        REST=$cu_batch              # markers, same snapshot rule
        while pop; do
            [ ! -f "$CHY_ROOT/db/installed/$POP/requested" ] ||
                CU_MARK="$CU_MARK$POP "
        done
        # Resolve the batch first, so a dependent's declared depends and
        # makedepends are present before its forced rebuild, the same promise
        # a plain install makes. A build tool removed since the last build
        # gets reinstalled instead of the build dying mid-run.
        resolve "$cu_batch"
        upgrade_run "$ORDER"
    done
    exit 0
}

# dispatch
# The color palette, root validation, then the verb. All of startup lives in
# main(), with main "$@" as the file's last line, not scattered through the
# file as top-level statements.
main() {
    set -u
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        C_ARROW=$(printf '\033[34m') C_PLUS=$(printf '\033[32m')
        C_MINUS=$(printf '\033[31m') C_OFF=$(printf '\033[0m')
    else
        C_ARROW='' C_PLUS='' C_MINUS='' C_OFF=''
    fi
    check_root

    case ${1-} in
        version)      shift; [ "$#" -eq 0 ] || { usage >&2; exit 2; }
                      printf '%s\n' "$CHY_VERSION" ;;
        ''|-h|--help) usage ;;
        install)      shift; cmd_install "$@" ;;
        upgrade)      shift; cmd_upgrade "$@" ;;
        remove)       shift; cmd_remove "$@" ;;
        list)         shift; cmd_list "$@" ;;
        outdated)     shift; cmd_outdated "$@" ;;
        why)          shift; cmd_why "$@" ;;
        provided)     shift; cmd_provided "$@" ;;
        doctor)       shift; cmd_doctor "$@" ;;
        *)            usage >&2; exit 2 ;;
    esac
}

main "$@"
